<Page x:Class="DMS.Views.ChatPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Chat">
    <Grid Background="#E8EDEF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Chat" Style="{StaticResource HeadingStyle}"/>
            <TextBlock Text="Private conversations with members and administrators." Foreground="#66727D" Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="#DDE3E5" BorderThickness="1" CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#F4F8F8" BorderBrush="#DDE3E5" BorderThickness="0,0,1,0" Padding="14">
                    <StackPanel>
                        <Button x:Name="InboxButton" Content="Inbox" Height="40" HorizontalContentAlignment="Left" Padding="14,0" Click="InboxButton_Click"/>
                        <Button x:Name="SentButton" Content="Sent" Height="40" HorizontalContentAlignment="Left" Padding="14,0" Margin="0,8,0,0" Click="SentButton_Click"/>
                        <Button Content="New chat" Height="40" HorizontalContentAlignment="Left" Padding="14,0" Margin="0,24,0,0" Click="NewChatButton_Click"/>
                        <TextBlock x:Name="ChatStatusText" Foreground="#B54736" TextWrapping="Wrap" Margin="4,18,4,0"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1" Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="ConversationTitle" Text="Inbox" FontSize="18" FontWeight="SemiBold" Foreground="#17212B"/>
                    <TextBox Grid.Row="1" x:Name="SearchTextBox" Height="34" Margin="0,12,0,10" Padding="8" TextChanged="SearchTextBox_TextChanged" ToolTip="Search users"/>
                    <ListBox Grid.Row="2" x:Name="ConversationList" BorderThickness="0" SelectionChanged="ConversationList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Margin="0,0,0,6" Background="#F8FBFB" CornerRadius="6">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding OtherDisplayName}" FontWeight="SemiBold" Foreground="#17212B"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding LatestMessageAt, StringFormat={}{0:HH:mm}}" Foreground="#66727D" FontSize="11"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding LatestMessage}" TextTrimming="CharacterEllipsis" Foreground="#66727D" Margin="0,4,0,0"/>
                                        <Border HorizontalAlignment="Left" Background="#E97858" CornerRadius="9" Padding="6,1" Margin="0,5,0,0">
                                            <TextBlock Text="{Binding UnreadCount}" Foreground="White" FontSize="11"/>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UnreadCount}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <ListBox Grid.Row="2" x:Name="PeopleList" Visibility="Collapsed" BorderThickness="0" SelectionChanged="PeopleList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Margin="0,0,0,6" Background="#F8FBFB" CornerRadius="6">
                                    <DockPanel>
                                        <Ellipse Width="9" Height="9" Fill="#1FAE67" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Role}" DockPanel.Dock="Right" Foreground="#66727D" FontSize="11"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <Grid Grid.Column="2" Background="#FBFCFC">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="#DDE3E5" BorderThickness="0,0,0,1" Padding="18,14">
                        <StackPanel>
                            <TextBlock x:Name="SelectedUserText" Text="Select a conversation" FontSize="18" FontWeight="SemiBold" Foreground="#17212B"/>
                            <TextBlock x:Name="SelectedRoleText" Foreground="#66727D" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                    <ListBox Grid.Row="1" x:Name="MessageList" BorderThickness="0" Background="Transparent" Padding="18,14" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="11,8" Margin="0,0,0,8" CornerRadius="10" MaxWidth="460" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#EAF2F3"/>
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                    <Setter Property="Background" Value="#D4EEE8"/>
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="#17212B"/>
                                        <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:HH:mm}}" FontSize="10" Foreground="#66727D" HorizontalAlignment="Right" Margin="12,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Row="2" BorderBrush="#DDE3E5" BorderThickness="0,1,0,0" Padding="14">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Send" Width="78" Height="36" Margin="10,0,0,0" Click="SendButton_Click"/>
                            <TextBox x:Name="MessageTextBox" MinHeight="36" Padding="10,7" VerticalContentAlignment="Center" AcceptsReturn="True" TextWrapping="Wrap" KeyDown="MessageTextBox_KeyDown" ToolTip="Write a message"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>