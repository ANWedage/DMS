<Page x:Class="DMS.Views.ChatPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Chat">
    <Page.Resources>
        <Style x:Key="ChatNavButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#34515B"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DDEDEA"/>
                    <Setter Property="Foreground" Value="#0D5558"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChatListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style x:Key="ChatPanelTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#17212B"/>
        </Style>
    </Page.Resources>
    <Grid Background="#E8EDEF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="CONVERSATIONS" Style="{StaticResource EyebrowStyle}"/>
                <TextBlock Text="Chat" Style="{StaticResource HeadingStyle}" Margin="0,4,0,0"/>
                <TextBlock Text="Private conversations with members and administrators." Style="{StaticResource MutedStyle}" Margin="0,6,0,0"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                <Border Background="#DCECE9" CornerRadius="16" Padding="13,8">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#2C9A75" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="CHAT WORKSPACE" Foreground="#0D5558" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Button Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" Width="38" Height="38" Margin="10,0,0,0"
                        Click="RefreshButton_Click" ToolTip="Refresh chat" Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="White" BorderBrush="#DDE3E5" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="184"/>
                    <ColumnDefinition Width="310"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#F4F8F8" BorderBrush="#DDE3E5" BorderThickness="0,0,1,0" Padding="16,18">
                    <StackPanel>
                        <TextBlock Text="MESSAGES" Style="{StaticResource EyebrowStyle}" Margin="4,0,0,12"/>
                        <Button x:Name="InboxButton" Style="{StaticResource ChatNavButtonStyle}" Click="InboxButton_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="28"/><TextBlock Text="Inbox" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button x:Name="SentButton" Style="{StaticResource ChatNavButtonStyle}" Click="SentButton_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F4;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="28"/><TextBlock Text="Sent" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource ChatNavButtonStyle}" Margin="0,16,0,0" Click="NewChatButton_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="28"/><TextBlock Text="New chat" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Border Background="#E8F0EF" CornerRadius="8" Padding="10" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="PRIVATE SPACE" Foreground="#0D5558" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="Your conversations stay between the selected people." Foreground="#66727D" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="ChatStatusBadge" Background="#FDEDED" BorderBrush="#F3C2C2" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,18,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="ChatStatusText" Foreground="#9B2C2C" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1" Background="#FFFFFF" Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Padding="18,18,16,0">
                        <StackPanel>
                            <TextBlock x:Name="ConversationTitle" Text="Inbox" Style="{StaticResource ChatPanelTitleStyle}"/>
                            <TextBlock Text="Your latest conversations" Style="{StaticResource MutedStyle}" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="1" Margin="18,12,16,10">
                        <TextBox x:Name="SearchTextBox" Height="36" Padding="34,8,10,8" TextChanged="SearchTextBox_TextChanged" ToolTip="Search users"/>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#88949B" FontSize="14" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                    <ListBox Grid.Row="2" x:Name="ConversationList" BorderThickness="0" Margin="16,0,12,12" SelectionChanged="ConversationList_SelectionChanged" Background="#F6F9F9" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10" BorderThickness="1" CornerRadius="10">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FFFFFF"/>
                                            <Setter Property="BorderBrush" Value="#E2EAE9"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#E8F3F1"/>
                                                    <Setter Property="BorderBrush" Value="#A6D7CF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Delete chat" Tag="{Binding}" Click="DeleteChatMenuItem_Click"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#DDEEEA" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding OtherDisplayName, Converter={StaticResource InitialsConverter}}" Foreground="#0D5558" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding OtherDisplayName}" FontWeight="SemiBold" Foreground="#17212B" FontSize="13"/>
                                            <TextBlock Text="{Binding LatestMessage}" TextTrimming="CharacterEllipsis" Foreground="#66727D" FontSize="12" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding LatestMessageAt, StringFormat={}{0:HH:mm}}" Foreground="#66727D" FontSize="11" Margin="0,0,0,6"/>
                                            <Border Background="#E97858" CornerRadius="9" Padding="6,2" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding UnreadCount}" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding UnreadCount}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <ListBox Grid.Row="2" x:Name="PeopleList" Visibility="Collapsed" BorderThickness="0" Margin="16,0,12,12" SelectionChanged="PeopleList_SelectionChanged" Background="#F6F9F9" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10" BorderThickness="1" CornerRadius="10">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FFFFFF"/>
                                            <Setter Property="BorderBrush" Value="#E2EAE9"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Role}" Value="Admin">
                                                    <Setter Property="Background" Value="#EEF6FF"/>
                                                    <Setter Property="BorderBrush" Value="#C9DCF7"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#E8F3F1"/>
                                                    <Setter Property="BorderBrush" Value="#A6D7CF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15" Background="#DDEEEA" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding DisplayName, Converter={StaticResource InitialsConverter}}" Foreground="#0D5558" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#17212B"/>

                                        <Border Grid.Column="2" CornerRadius="6" Padding="6,2" Margin="8,0,0,0" Background="#DCE9F6">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Role}" Value="Admin">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Role}" Foreground="#34515B" FontSize="10" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <Grid Grid.Column="2" Background="#FBFCFC">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#DDE3E5" BorderThickness="0,0,0,1" Padding="20,16">
                        <DockPanel>
                            <Border Width="40" Height="40" Background="#DCECE9" CornerRadius="20" DockPanel.Dock="Left" Margin="0,0,12,0">
                                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="#0D5558" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Button DockPanel.Dock="Right" Width="30" Height="30" Margin="10,0,0,0" Click="CloseChatButton_Click" ToolTip="Close current chat"
                                    Background="#FDEAE7" BorderBrush="#F0B7AC" BorderThickness="1" Foreground="#B54736" Padding="0"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Border.CornerRadius="15" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="15">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="×" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                            </Button>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="SelectedUserText" Text="Select a conversation" FontSize="18" FontWeight="SemiBold" Foreground="#17212B"/>
                                <TextBlock x:Name="SelectedRoleText" Foreground="#34515B" FontWeight="SemiBold" FontSize="12" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ListBox Grid.Row="1" x:Name="MessageList" BorderThickness="0" Background="Transparent" Padding="18,14" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8" HorizontalAlignment="Stretch">
                                    <Border Padding="11,8" CornerRadius="10" MaxWidth="460">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#EAF2F3"/>
                                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                        <Setter Property="Background" Value="#D4EEE8"/>
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <Border Background="#E7F2F3" BorderBrush="#CFE2E2" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,6" Visibility="{Binding AttachmentVisible}">
                                                <DockPanel>
                                                    <Border Width="18" Height="18" CornerRadius="4" Background="#D9ECE6" Margin="0,0,8,0">
                                                        <TextBlock Text="PDF" Foreground="#0D5558" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding AttachmentName}" Foreground="#17212B" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Border>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="#17212B" Visibility="{Binding TextVisible}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <Button Content="Download PDF" Visibility="{Binding AttachmentVisible}" Tag="{Binding AttachmentId}" Click="DownloadAttachmentButton_Click" Margin="0,0,8,0" Cursor="Hand"/>
                                                <Button Content="Delete" Visibility="{Binding DeleteVisible}" Tag="{Binding AttachmentId}" Click="DeleteAttachmentButton_Click" Background="#FCEBE7" Foreground="#B54736" Cursor="Hand"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:HH:mm}}" FontSize="10" Foreground="#66727D" HorizontalAlignment="Right" Margin="12,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#DDE3E5" BorderThickness="0,1,0,0" Padding="16">
                        <StackPanel>
                            <Border x:Name="AttachmentPreviewBorder" Background="#EAF7F2" BorderBrush="#B7DCCB" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,10" Visibility="Collapsed">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="Ready to send" Foreground="#0D5558" FontWeight="SemiBold" FontSize="11"/>
                                        <TextBlock x:Name="AttachmentPreviewNameText" Text="sample.pdf" Foreground="#17212B" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                        <TextBlock x:Name="AttachmentPreviewMetaText" Text="0 KB" Foreground="#66727D" FontSize="11"/>
                                    </StackPanel>
                                    <Button DockPanel.Dock="Right" Width="30" Height="30" Margin="12,0,0,0" Click="ClearPendingAttachment_Click" ToolTip="Remove PDF"
                                            Background="#FDEAE7" BorderBrush="#F0B7AC" BorderThickness="1" Foreground="#B54736" Padding="0"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Border.CornerRadius="15">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="15">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="×" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                                    </Button>
                                </DockPanel>
                            </Border>
                            <DockPanel>
                                <Button DockPanel.Dock="Left" Width="38" Height="38" Margin="0,0,8,0" Click="UploadPdfButton_Click" ToolTip="Upload PDF" Background="#EEF5F5" BorderBrush="#D9E6E4" BorderThickness="1" Foreground="#0D5558" FontSize="20" FontWeight="Bold" Cursor="Hand">
                                    <TextBlock Text="+" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,-2,0,0"/>
                                </Button>
                                <Button DockPanel.Dock="Right" Content="Send" Width="82" Height="38" Margin="10,0,0,0" Click="SendButton_Click" Cursor="Hand"/>
                                <Grid>
                                    <TextBox x:Name="MessageTextBox" MinHeight="42" Padding="12,9" VerticalContentAlignment="Center" AcceptsReturn="True" TextWrapping="Wrap" KeyDown="MessageTextBox_KeyDown" TextChanged="MessageTextBox_TextChanged" ToolTip="Write a message"/>
                                    <TextBlock x:Name="MessagePlaceholderText" Text="Write a message..." Foreground="#829197" Margin="12,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                </Grid>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>