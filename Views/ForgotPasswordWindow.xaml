<Window x:Class="DMS.Views.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reset password"
        Width="420" Height="390"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Reset your password" Style="{StaticResource HeadingStyle}" FontSize="24"/>
        <TextBlock Grid.Row="2" Text="Enter your username to find your account." Style="{StaticResource MutedStyle}"/>

        <TextBlock Grid.Row="4" Text="Account type" Style="{StaticResource LabelStyle}"/>
        <ComboBox Grid.Row="5" x:Name="RoleComboBox" SelectedIndex="0" Height="40" Padding="10,0">
            <ComboBoxItem Content="User"/>
            <ComboBoxItem Content="Admin"/>
        </ComboBox>

        <TextBlock Grid.Row="8" Text="Username" Style="{StaticResource LabelStyle}"/>
        <TextBox Grid.Row="9" x:Name="UsernameBox" ToolTip="Enter your username"/>

        <TextBlock Grid.Row="11" x:Name="ErrorText" Foreground="#B54736" TextWrapping="Wrap" MinHeight="20"/>

        <StackPanel Grid.Row="13" x:Name="PasswordPanel" Visibility="Collapsed">
            <TextBlock Text="New password" Style="{StaticResource LabelStyle}"/>
            <PasswordBox x:Name="NewPasswordBox" Margin="0,6,0,0"/>

            <TextBlock Text="Confirm password" Style="{StaticResource LabelStyle}" Margin="0,12,0,0"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Margin="0,6,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="14" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Width="110" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Click="CancelButton_Click"/>
            <Button x:Name="NextButton" Content="Next" Width="110" Click="NextButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
