<Window x:Class="DMS.Views.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reset password"
        Width="440" Height="430"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
            <StackPanel Margin="22" Width="360" HorizontalAlignment="Center">
                <TextBlock Text="Reset your password" Style="{StaticResource HeadingStyle}" FontSize="24" Margin="0,0,0,6"/>
                <TextBlock Text="Enter your username to find your account." Style="{StaticResource MutedStyle}" Margin="0,0,0,14"/>

                <TextBlock Text="Username" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="UsernameBox" Width="360" Height="42" ToolTip="Enter your username" VerticalContentAlignment="Center" Margin="0,6,0,0"/>

                <TextBlock x:Name="AccountStatusText" Foreground="#2E7D32" TextWrapping="Wrap" MinHeight="20" Margin="0,10,0,0" Visibility="Collapsed"/>
                <TextBlock x:Name="ErrorText" Foreground="#B54736" TextWrapping="Wrap" MinHeight="20" Margin="0,8,0,0"/>

                <StackPanel x:Name="PasswordPanel" Width="360" Visibility="Collapsed" Margin="0,6,0,0">
                    <TextBlock Text="New password" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="NewPasswordBox" Width="360" Height="42" VerticalContentAlignment="Center" Visibility="Visible"/>
                    <TextBox x:Name="NewPasswordTextBox" Width="360" Height="42" VerticalContentAlignment="Center" Visibility="Collapsed"/>

                    <TextBlock Text="Confirm password" Style="{StaticResource LabelStyle}" Margin="0,12,0,6"/>
                    <PasswordBox x:Name="ConfirmPasswordBox" Width="360" Height="42" VerticalContentAlignment="Center" Visibility="Visible"/>
                    <TextBox x:Name="ConfirmPasswordTextBox" Width="360" Height="42" VerticalContentAlignment="Center" Visibility="Collapsed"/>

                    <CheckBox x:Name="ShowPasswordCheckBox" Content="Show password" Margin="0,12,0,12" Checked="ShowPasswordCheckBox_Checked" Unchecked="ShowPasswordCheckBox_Unchecked"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button x:Name="CancelButton" Content="Cancel" Width="110" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Click="CancelButton_Click"/>
                    <Button x:Name="NextButton" Content="Check account" Width="150" Click="NextButton_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
