<Window x:Class="DMS.Views.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DMS Update Available"
        Width="760"
        Height="640"
        MinWidth="720"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="#2B3036"
        FontFamily="Segoe UI">
    <Grid Margin="24">
        <Border Width="620"
                Background="#2B3036"
                BorderBrush="#4A535E"
                BorderThickness="1"
                CornerRadius="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Image Grid.Row="0"
                       Source="/Assets/dms-logo.png"
                       Width="96"
                       Height="96"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,18"/>

                <TextBlock Grid.Row="1"
                           Text="About DMS"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>

                <TextBlock x:Name="VersionTextBlock"
                           Grid.Row="2"
                           Margin="0,10,0,0"
                           Text="Version 1.0.0"
                           FontSize="18"
                           Foreground="#D7DFE4"
                           HorizontalAlignment="Center"/>

                <TextBlock x:Name="StatusTextBlock"
                           Grid.Row="3"
                           Margin="0,18,0,0"
                           Text="A new DMS update is available. You can download and install it now."
                           FontSize="18"
                           Foreground="White"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"/>

                <Button x:Name="UpdateButton"
                        Grid.Row="4"
                        Content="Update Now"
                        Width="180"
                        Height="42"
                        Margin="0,22,0,0"
                        HorizontalAlignment="Center"
                        Click="UpdateButton_Click"/>

                <StackPanel Grid.Row="5" Margin="0,22,0,0">
                    <TextBlock Text="Download status" FontSize="13" FontWeight="SemiBold" Foreground="#D7DFE4" Margin="0,0,0,8"/>
                    <ProgressBar x:Name="DownloadProgressBar" Height="12" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,10"/>
                    <TextBlock x:Name="ProgressStatusText" Text="Ready to update now." Foreground="#D7DFE4" FontSize="13"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
