<Page x:Class="DMS.Views.MyTasksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="My Tasks">
    <Grid Background="#F5F7F8" Margin="30">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="My Tasks" FontSize="32" FontWeight="Bold" Foreground="#17212B"/>
            <TextBlock Text="Review your assigned components and record what you worked on today." Margin="0,8,0,0" Foreground="#66727D"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" Padding="14" BorderBrush="#DDE3E5" BorderThickness="1">
                <ListBox x:Name="TaskListBox" SelectionChanged="TaskListBox_SelectionChanged" BorderThickness="0">
                    <ListBox.ItemTemplate><DataTemplate>
                        <Border Padding="10" Margin="0,0,0,8" BorderBrush="#DDE3E5" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding Component.Name}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Project.Name}" Foreground="#66727D" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding Component.Status}" Foreground="#126E70" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding LatestUpdate.UpdateDate, StringFormat=Last update: {0:d}}" Foreground="#66727D" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <Border Grid.Column="2" Background="White" Padding="20" BorderBrush="#DDE3E5" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="ComponentTitleText" Text="Select a task" FontSize="24" FontWeight="Bold"/>
                        <TextBlock x:Name="ProjectText" Foreground="#66727D" Margin="0,5,0,0"/>
                        <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        <TextBlock x:Name="DueDateText" Foreground="#66727D" Margin="0,7,0,0"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="#F7F9F9" Padding="14" Margin="0,18,0,18">
                        <StackPanel>
                            <TextBlock Text="Daily Work Update" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Describe the work you completed today." Margin="0,6,0,0" Foreground="#66727D"/>
                            <TextBox x:Name="DailyDescriptionTextBox" Height="85" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"/>
                            <ComboBox x:Name="TaskStatusComboBox" Margin="0,8,0,0">
                                <ComboBoxItem Content="Not started"/><ComboBoxItem Content="In progress"/><ComboBoxItem Content="Blocked"/><ComboBoxItem Content="Completed"/>
                            </ComboBox>
                            <TextBox x:Name="BlockedReasonTextBox" Height="55" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" ToolTip="Explain what is blocking the task"/>
                            <Button Content="Save Today's Update" Click="SaveUpdateButton_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                            <TextBlock x:Name="MessageText" Foreground="#126E70" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Row="2" Text="My Daily History" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <ListView Grid.Row="3" x:Name="HistoryListView" BorderThickness="0">
                        <ListView.View><GridView>
                            <GridViewColumn Header="Date" DisplayMemberBinding="{Binding UpdateDate, StringFormat=d}" Width="100"/>
                            <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="110"/>
                            <GridViewColumn Header="Description" DisplayMemberBinding="{Binding Description}" Width="400"/>
                        </GridView></ListView.View>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>