<Page x:Class="DMS.Views.MyTasksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="My Tasks">
    <Page.Resources>
        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDE3E5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>
        <Style x:Key="TaskListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Background="#E8EDEF" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="MY WORKSPACE" Style="{StaticResource EyebrowStyle}"/>
                    <TextBlock Text="My Tasks" Style="{StaticResource HeadingStyle}" Margin="0,4,0,0"/>
                    <TextBlock x:Name="TaskProgressText" Text="Loading your personal task workspace..." Style="{StaticResource MutedStyle}" Margin="0,7,0,0"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <Border Background="#DCECE9" CornerRadius="18" Padding="14,8">
                        <TextBlock Text="FOCUS MODE" Foreground="#0D5558" FontWeight="SemiBold" FontSize="12"/>
                    </Border>
                    <Button Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" Width="38" Height="38" Margin="10,0,0,0"
                            Click="RefreshButton_Click" ToolTip="Refresh my tasks"/>
                </StackPanel>
            </Grid>

            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,20">
                <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,10,0">
                    <StackPanel><TextBlock Text="ASSIGNED TASKS" Style="{StaticResource EyebrowStyle}"/><TextBlock x:Name="AssignedCountText" Text="0" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"/><TextBlock Text="Across your projects" Style="{StaticResource MutedStyle}" FontSize="12"/></StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,10,0">
                    <StackPanel><TextBlock Text="DUE SOON" Foreground="#B26A00" FontWeight="SemiBold" FontSize="12"/><TextBlock x:Name="DueSoonCountText" Text="0" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"/><TextBlock Text="Within the next 7 days" Style="{StaticResource MutedStyle}" FontSize="12"/></StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,10,0">
                    <StackPanel><TextBlock Text="BLOCKED" Foreground="#B54736" FontWeight="SemiBold" FontSize="12"/><TextBlock x:Name="BlockedCountText" Text="0" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"/><TextBlock Text="Need attention" Style="{StaticResource MutedStyle}" FontSize="12"/></StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel><TextBlock Text="COMPLETED TODAY" Foreground="#126E70" FontWeight="SemiBold" FontSize="12"/><TextBlock x:Name="CompletedTodayCountText" Text="0" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"/><TextBlock Text="Keep the momentum" Style="{StaticResource MutedStyle}" FontSize="12"/></StackPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" BorderBrush="#DDE3E5" BorderThickness="1" CornerRadius="10" Padding="16">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                            <TextBlock Text="Your task list" Style="{StaticResource SectionHeadingStyle}"/>
                            <TextBlock Text="Choose a task to update your progress." Style="{StaticResource MutedStyle}" Margin="0,4,0,10"/>
                            <TextBox x:Name="TaskSearchTextBox" Height="38" TextChanged="TaskSearchTextBox_TextChanged" ToolTip="Search tasks or projects"/>
                            <ComboBox x:Name="TaskFilterComboBox" Height="36" Margin="0,8,0,0" SelectionChanged="TaskFilterComboBox_SelectionChanged">
                                <ComboBoxItem Content="All tasks" IsSelected="True"/>
                                <ComboBoxItem Content="In progress"/>
                                <ComboBoxItem Content="Due soon"/>
                                <ComboBoxItem Content="Blocked"/>
                                <ComboBoxItem Content="Completed"/>
                            </ComboBox>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ListBox x:Name="TaskListBox" SelectionChanged="TaskListBox_SelectionChanged" BorderThickness="0" ItemContainerStyle="{StaticResource TaskListItemStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="12" BorderBrush="#DDE3E5" BorderThickness="1" CornerRadius="7" Background="#FBFCFC">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Component.Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Project.Name}" Foreground="#66727D" FontSize="12" Margin="0,4,0,0"/>
                                                <Grid Margin="0,10,0,0">
                                                    <TextBlock Text="{Binding Component.Status}" Foreground="#126E70" FontWeight="SemiBold" FontSize="12"/>
                                                    <TextBlock Text="{Binding Component.Priority}" HorizontalAlignment="Right" Foreground="#66727D" FontSize="12"/>
                                                </Grid>
                                                <TextBlock Text="{Binding Component.DueDate, StringFormat=Due {0:dd MMM yyyy}}" Foreground="#66727D" FontSize="12" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Background="White" BorderBrush="#DDE3E5" BorderThickness="1" CornerRadius="10" Padding="22">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <StackPanel Margin="0,0,150,0">
                                    <TextBlock Text="SELECTED TASK" Style="{StaticResource EyebrowStyle}"/>
                                    <TextBlock x:Name="ComponentTitleText" Text="Select a task" FontSize="26" FontWeight="Bold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="ProjectText" Foreground="#66727D" Margin="0,5,0,0"/>
                                    <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" Margin="0,14,0,0"/>
                                    <TextBlock x:Name="DueDateText" Foreground="#126E70" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#E8F0EF" CornerRadius="7" Padding="12,9">
                                    <StackPanel><TextBlock Text="TODAY" Foreground="#0D5558" FontWeight="Bold" FontSize="11"/><TextBlock Text="Update your progress" Foreground="#126E70" FontSize="12" Margin="0,3,0,0"/></StackPanel>
                                </Border>
                            </Grid>

                            <Border Grid.Row="1" Background="#F5F8F7" BorderBrush="#DCE8E5" BorderThickness="1" Padding="18" Margin="0,22,0,22" CornerRadius="9">
                                <StackPanel>
                                    <TextBlock Text="Today's update" Style="{StaticResource SectionHeadingStyle}"/>
                                    <TextBlock Text="Record the work you completed or the study session you focused on." Style="{StaticResource MutedStyle}" Margin="0,4,0,12"/>
                                    <TextBlock Text="Update type" Style="{StaticResource LabelStyle}"/>
                                    <ComboBox x:Name="UpdateTypeComboBox" Height="38" Margin="0,6,0,0" SelectionChanged="UpdateTypeComboBox_SelectionChanged">
                                        <ComboBoxItem Content="Assigned task"/>
                                        <ComboBoxItem Content="Self study"/>
                                    </ComboBox>
                                    <Grid x:Name="SelfStudyTopicInputPanel" Margin="0,8,0,0" Visibility="Collapsed">
                                        <TextBox x:Name="SelfStudyTopicTextBox" Height="40" ToolTip="Topic you studied today"/>
                                        <TextBlock Text="What did you study today?" Margin="13,0,13,0" VerticalAlignment="Center" Foreground="#88949B" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=SelfStudyTopicTextBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <TextBlock Text="What did you work on?" Style="{StaticResource LabelStyle}" Margin="0,14,0,0"/>
                                    <Grid Margin="0,6,0,0">
                                        <TextBox x:Name="DailyDescriptionTextBox" Height="95" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                                        <TextBlock x:Name="DailyDescriptionPlaceholderText" Text="Describe the work you completed on this assigned task..." Margin="13,11,13,0" VerticalAlignment="Top" Foreground="#88949B" IsHitTestVisible="False" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=DailyDescriptionTextBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <TextBlock Text="Current status" Style="{StaticResource LabelStyle}" Margin="0,14,0,0"/>
                                    <ComboBox x:Name="TaskStatusComboBox" Height="38" Margin="0,6,0,0">
                                        <ComboBoxItem Content="Not started"/><ComboBoxItem Content="In progress"/><ComboBoxItem Content="Blocked"/><ComboBoxItem Content="Completed"/>
                                    </ComboBox>
                                    <TextBox x:Name="BlockedReasonTextBox" Height="60" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Margin="0,8,0,0" Visibility="Collapsed" ToolTip="Explain what is blocking the task"/>
                                    <DockPanel Margin="0,14,0,0">
                                        <TextBlock x:Name="MessageText" DockPanel.Dock="Right" Foreground="#126E70" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        <Button Content="Save today's update" Click="SaveUpdateButton_Click" HorizontalAlignment="Left"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="2" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Recent activity" Style="{StaticResource SectionHeadingStyle}"/>
                                    <TextBlock Text="Your personal record of submitted work." Style="{StaticResource MutedStyle}" Margin="0,4,0,10"/>
                                </StackPanel>
                                <TextBlock Text="LATEST FIRST" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="#88949B" FontSize="11" FontWeight="SemiBold"/>
                            </Grid>
                            <Border Grid.Row="3" Background="#F5F8F7" Margin="0,0,0,2" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="155"/><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="DATE" Foreground="#66727D" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="TYPE" Foreground="#66727D" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="2" Text="STATUS" Foreground="#66727D" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="3" Text="WORK SUMMARY" Foreground="#66727D" FontSize="11" FontWeight="SemiBold"/>
                                </Grid>
                            </Border>
                            <ListView Grid.Row="4" x:Name="HistoryListView" BorderThickness="0" Background="Transparent">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="10,0"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#DDE3E5" BorderThickness="0,0,0,1" Padding="0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="155"/><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding UpdateDate, StringFormat={}{0:dd MMM}}" Foreground="#126E70" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding UpdateType}" Foreground="#17212B"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="#66727D"/>
                                                <StackPanel Grid.Column="3">
                                                    <TextBlock Text="{Binding Topic}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Description}" Foreground="#66727D" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>