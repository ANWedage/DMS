<Page x:Class="DMS.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Dashboard">
    <Grid Background="#E8EDEF">
        <StackPanel Margin="30">
            <TextBlock Text="Dashboard" FontSize="32" FontWeight="Bold" Foreground="#17212B"/>
            <TextBlock Text="Overview of current operations and team status." Margin="0,12,0,0" Foreground="#66727D"/>

            <WrapPanel Margin="0,26,0,0">
                <Border Width="180" Height="100" Background="#0F4C5C" CornerRadius="12" Margin="0,0,20,20">
                    <StackPanel Margin="18">
                        <TextBlock Text="Active users" Foreground="White" FontSize="13" Opacity="0.85"/>
                        <TextBlock x:Name="ActiveUsersCountText" Text="Loading..." Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </StackPanel>
    </Grid>
</Page>
