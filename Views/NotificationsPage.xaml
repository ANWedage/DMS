<Page x:Class="DMS.Views.NotificationsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Notifications">
    <Grid Background="#E8EDEF" Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Notifications" Style="{StaticResource HeadingStyle}"/>
                <StackPanel>
                    <TextBlock x:Name="UnreadCountText" Text="Loading unread notifications..." Margin="0,8,0,0" Style="{StaticResource MutedStyle}"/>
                    <StackPanel x:Name="AdminHistoryButtons" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed">
                        <Button x:Name="AdminInboxButton" Content="Inbox" Click="AdminInboxButton_Click" Margin="0,0,8,0"/>
                        <Button x:Name="AdminSentButton" Content="Sent history" Click="AdminSentButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button x:Name="RefreshButton" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" Width="38" Height="38" Margin="0,0,10,0"
                    Click="RefreshButton_Click" ToolTip="Refresh notifications"/>
                <Button x:Name="MarkAllReadButton" Content="Mark all as read" Style="{StaticResource SecondaryButtonStyle}" Click="MarkAllReadButton_Click"/>
                </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="ComposeColumn" Width="0"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="10">
                <ListView x:Name="NotificationList"
                          BorderThickness="0"
                          Background="Transparent"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.PanningMode="VerticalOnly"
                          VirtualizingPanel.ScrollUnit="Pixel">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="8"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRead}" Value="False">
                                    <Setter Property="Background" Value="#E8F5F3"/>
                                </DataTrigger>
                                    <DataTrigger Binding="{Binding IsHighPriority}" Value="True">
                                        <Setter Property="Background" Value="#FFF0C2"/>
                                        <Setter Property="BorderBrush" Value="#D89000"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="Bold" FontSize="16" TextWrapping="Wrap"/>
                                    <Button Grid.Column="1" Content="Mark read" Tag="{Binding Id}" Width="92" Height="28"
                                            Padding="6,2" HorizontalAlignment="Right" Click="MarkReadButton_Click">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRead}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSent}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Grid.Column="2" Content="&#xE74D;" Tag="{Binding Id}" Width="32" Height="28"
                                            Margin="6,0,0,0" FontFamily="Segoe MDL2 Assets" Padding="0"
                                            Click="DeleteSentNotificationButton_Click" ToolTip="Delete sent notification">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSent}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,7,0,0">
                                    <TextBlock Text="From " Foreground="#66727D">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding IsSent}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding SenderName}" Foreground="#66727D">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding IsSent}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="To " Foreground="#66727D">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding IsSent}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding RecipientName}" Foreground="#66727D">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding IsSent}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="  |  " Foreground="#66727D"/>
                                    <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:dd MMM yyyy HH:mm}}" Foreground="#66727D"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
            <Border x:Name="ComposePanel" Grid.Column="1" Background="White" CornerRadius="10" Padding="20" Margin="18,0,0,0" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Send a notification" Style="{StaticResource SectionHeadingStyle}"/>
                        <TextBlock Text="Audience" Style="{StaticResource LabelStyle}" Margin="0,18,0,0"/>
                        <ComboBox x:Name="RecipientRoleBox" Height="36" Margin="0,6,0,0" SelectionChanged="RecipientRoleBox_SelectionChanged">
                            <ComboBoxItem Content="Users" Tag="User" IsSelected="True"/>
                            <ComboBoxItem Content="Admins" Tag="Admin"/>
                        </ComboBox>
                        <CheckBox x:Name="SendToAllBox" Content="Send to everyone in this group" Margin="0,14,0,8" IsChecked="True" Click="SendToAllBox_Click"/>
                        <TextBlock Text="Choose recipient" Style="{StaticResource LabelStyle}"/>
                        <Border Margin="0,6,0,0" Background="White" BorderBrush="#B7D6DD" BorderThickness="1" CornerRadius="6" Padding="8,0">
                            <DockPanel>
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#66727D" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="RecipientSearchBox" Height="36" BorderThickness="0"
                                         VerticalContentAlignment="Center"
                                         TextChanged="RecipientSearchBox_TextChanged"
                                         ToolTip="Search recipients by name, username, or email"/>
                            </DockPanel>
                        </Border>
                        <ListBox x:Name="RecipientListBox" Height="185" Margin="0,6,0,0"
                                 IsEnabled="False"
                                 SelectionMode="Single"
                                 BorderBrush="#DDE3E5"
                                 BorderThickness="1"
                                 Background="White"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.PanningMode="VerticalOnly"
                                 PreviewMouseWheel="RecipientListBox_PreviewMouseWheel"
                                 SelectionChanged="RecipientListBox_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#EDF1F2"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#E5F4F2"/>
                                            <Setter Property="Foreground" Value="#0D5558"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Role}" FontSize="11" Foreground="#66727D" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="RecipientSelectionText" Text="Send to everyone in this group" Foreground="#66727D" FontSize="11" Margin="0,5,0,0"/>
                        <TextBlock Text="Title" Style="{StaticResource LabelStyle}" Margin="0,16,0,0"/>
                        <TextBox x:Name="TitleBox"/>
                        <TextBlock Text="Message" Style="{StaticResource LabelStyle}" Margin="0,12,0,0"/>
                        <TextBox x:Name="MessageTextBox" Height="180" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/>
                        <TextBlock x:Name="ComposeErrorText" Style="{StaticResource ErrorStyle}" Margin="0,8,0,0"/>
                        <Button Content="Send notification" Margin="0,10,0,0" Click="SendButton_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Grid x:Name="LoadingOverlay" Grid.RowSpan="2" Background="#800F1A24" Visibility="Collapsed" Panel.ZIndex="10">
            <Border Width="260" Height="120" Background="White" CornerRadius="16" BorderBrush="#D7E5EA" BorderThickness="1.2">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar Width="42" Height="42" IsIndeterminate="True" Foreground="#0F4C5C" Margin="0,0,0,12"/>
                    <TextBlock Text="Loading notifications..." FontSize="16" FontWeight="SemiBold" Foreground="#12343D" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
