<Window x:Class="DMS.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DMS | Create account"
        Icon="/Assets/dms-logo.png"
        Height="650" Width="820"
        MinHeight="650" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.95*"/>
            <ColumnDefinition Width="1.05*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource CoralBrush}" Padding="42">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="/Assets/dms-logo.png" Width="270" Height="270"
                       Stretch="Uniform" HorizontalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" ToolTip="DMS logo"/>
                <TextBlock Text="Developer Management System"
                           FontFamily="pack://application:,,,/DMS;component/Assets/#Lato"
                           Foreground="White"
                           FontSize="16" FontWeight="SemiBold" TextAlignment="Center"
                           Margin="0,14,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="58,44,58,42">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="22"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Create your account" Style="{StaticResource HeadingStyle}"/>
            <TextBlock Grid.Row="2" Text="Use your work email to get started." Style="{StaticResource MutedStyle}"/>

            <TextBlock Grid.Row="4" Text="Email address" Style="{StaticResource LabelStyle}"/>
            <TextBox Grid.Row="5" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Enter your email address"/>

            <TextBlock Grid.Row="7" Text="Contact number" Style="{StaticResource LabelStyle}"/>
            <TextBox Grid.Row="8" Text="{Binding ContactNumber, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Enter your contact number"/>

            <TextBlock Grid.Row="10" Text="Password" Style="{StaticResource LabelStyle}"/>
            <PasswordBox Grid.Row="11" x:Name="PasswordBox" ToolTip="Use at least 6 characters"/>

            <TextBlock Grid.Row="13" Text="Confirm password" Style="{StaticResource LabelStyle}"/>
            <PasswordBox Grid.Row="14" x:Name="ConfirmPasswordBox" ToolTip="Re-enter your password"/>

            <TextBlock Grid.Row="16" Text="{Binding ErrorMessage}" Style="{StaticResource ErrorStyle}" Margin="0,12,0,0"/>
            <Button Grid.Row="18" Content="Create account" Command="{Binding CreateAccountCommand}" Height="46" IsDefault="True"/>
        </Grid>
    </Grid>
</Window>
