<Window x:Class="DMS.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DMS"
        xmlns:helpers="clr-namespace:DMS.Helpers"
        Title="DMS | Admin Workspace"
        Icon="/Assets/dms-logo.png"
        Height="680" Width="1120"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#E8EDEF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#172C38" Padding="24,28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Text="DMS Admin" Foreground="White" FontSize="28" FontWeight="Bold"/>

                    <StackPanel Margin="0,28,0,0">
                    <Button Height="42" Margin="0,0,0,10" Background="#245465" Foreground="White"
                            BorderThickness="0" FontWeight="SemiBold" HorizontalContentAlignment="Left" Padding="16,0,0,0"
                            Click="AllDevelopersButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="30"/><TextBlock Text="Developer Management" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button Height="42" Margin="0,0,0,10" Background="#245465" Foreground="White"
                            BorderThickness="0" FontWeight="SemiBold" HorizontalContentAlignment="Left" Padding="16,0,0,0"
                            Click="TasksButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="30"/><TextBlock Text="Task Management" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button Height="42" Margin="0,0,0,10" Background="#245465" Foreground="White"
                            BorderThickness="0" FontWeight="SemiBold" HorizontalContentAlignment="Left" Padding="16,0,0,0"
                            Click="AttendanceTrackingButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="30"/><TextBlock Text="Track Attendance" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button Height="42" Margin="0,0,0,10" Background="#245465" Foreground="White"
                            BorderThickness="0" FontWeight="SemiBold" HorizontalContentAlignment="Left" Padding="16,0,0,0"
                            Click="FormsButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="30"/><TextBlock Text="Google Forms" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button Height="42" Margin="0,0,0,10" Background="#245465" Foreground="White"
                            BorderThickness="0" FontWeight="SemiBold" HorizontalContentAlignment="Left" Padding="16,0,0,0"
                            Click="ChatButton_Click">
                            <DockPanel>
                                <Border x:Name="AdminChatBadge" DockPanel.Dock="Right" Background="#E97858" CornerRadius="10" Padding="7,2" Margin="10,0,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="AdminChatCountText" Foreground="White" FontWeight="Bold"/>
                                </Border>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="30"/><TextBlock Text="Chat" VerticalAlignment="Center"/></StackPanel>
                            </DockPanel>
                        </Button>
                        <Button Height="42" Background="#245465" Foreground="White"
                            BorderThickness="0" FontWeight="SemiBold" HorizontalContentAlignment="Left" Padding="16,0,0,0"
                            Click="NotificationsButton_Click">
                            <DockPanel>
                                <Border x:Name="AdminNotificationBadge" DockPanel.Dock="Right" Background="#E97858" CornerRadius="10" Padding="7,2" Margin="10,0,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="AdminNotificationCountText" Foreground="White" FontWeight="Bold"/>
                                </Border>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="30"/><TextBlock Text="Notifications" VerticalAlignment="Center"/></StackPanel>
                            </DockPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,16,0,0" HorizontalAlignment="Stretch">
                    <Button Height="42" Background="#245465" Foreground="White"
                            BorderThickness="0" FontWeight="SemiBold" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" Padding="16,0,0,0"
                            Click="SettingsButton_Click" ToolTip="Open admin settings">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="30"/><TextBlock Text="Settings" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Foreground="#D7E0E4" FontSize="11"
                               Text="v{x:Static local:App.CurrentVersion}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="#E8EDEF" Margin="42,34,42,36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Border Background="#F8FBFB" BorderBrush="#B7D6DD" BorderThickness="1" CornerRadius="8" Padding="12,7">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Administrator" Foreground="#17212B" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Static helpers:AppSession.CurrentDisplayName}" Foreground="#66727D" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Button Content="⏻" Click="SignOutButton_Click" Margin="12,0,0,0" Width="36" Height="36"
                        Background="#0F4C5C" Foreground="White" FontSize="20" ToolTip="Sign out"
                        BorderThickness="0" Padding="0" Cursor="Hand"/>
            </StackPanel>

            <Border x:Name="AdminTaskReminderBanner" Grid.Row="1" Margin="0,16,0,0" Visibility="Collapsed" BorderBrush="#D64545" BorderThickness="3" CornerRadius="14" Padding="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FFF8DF" Offset="0"/>
                        <GradientStop Color="#FFE0A8" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.28" Color="#8A5A00"/>
                </Border.Effect>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.22"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="68"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#D64545" CornerRadius="10,0,0,10">
                        <TextBlock Text="!" Foreground="White" FontSize="30" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="18,14,18,14">
                        <TextBlock Text="Daily task reminder" Foreground="#6D2B1B" FontWeight="Bold" FontSize="18"/>
                        <TextBlock Text="Complete and submit your task update before the workday ends." Foreground="#6D2B1B" Margin="0,4,0,0" FontSize="14" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Frame x:Name="MainContentFrame" Grid.Row="2" Margin="0,30,0,0" NavigationUIVisibility="Hidden" />
            <TextBlock Grid.Row="3" Text="Developed By Adeepa Wedage" Foreground="#1A3D45"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,12,0,0"/>
        </Grid>
    </Grid>
</Window>
