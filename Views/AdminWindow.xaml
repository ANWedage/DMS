<Window x:Class="DMS.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:DMS.Helpers"
        Title="DMS | Admin Workspace"
        Icon="/Assets/dms-logo.png"
        Height="680" Width="1120"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0F4C5C" Padding="24,28">
            <StackPanel>
                <TextBlock Text="DMS Admin" Foreground="White" FontSize="28" FontWeight="Bold"/>

                <StackPanel Margin="0,28,0,0">
                    <Button Height="42" Margin="0,0,0,10" Background="#146A7A" Foreground="White"
                            BorderThickness="0" FontWeight="SemiBold" HorizontalContentAlignment="Left" Padding="16,0,0,0"
                            Click="AllDevelopersButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="30"/><TextBlock Text="Developer Management" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button Height="42" Margin="0,0,0,10" Background="#146A7A" Foreground="White"
                            BorderThickness="0" FontWeight="SemiBold" HorizontalContentAlignment="Left" Padding="16,0,0,0"
                            Click="TasksButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="30"/><TextBlock Text="Task Management" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button Height="42" Margin="0,0,0,10" Background="#146A7A" Foreground="White"
                            BorderThickness="0" FontWeight="SemiBold" HorizontalContentAlignment="Left" Padding="16,0,0,0"
                            Click="AttendanceTrackingButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="30"/><TextBlock Text="Track Attendance" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button Height="42" Background="#146A7A" Foreground="White"
                            BorderThickness="0" FontWeight="SemiBold" HorizontalContentAlignment="Left" Padding="16,0,0,0"
                            Click="NotificationsButton_Click">
                            <DockPanel>
                                <Border x:Name="AdminNotificationBadge" DockPanel.Dock="Right" Background="#E97858" CornerRadius="10" Padding="7,2" Margin="10,0,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="AdminNotificationCountText" Foreground="White" FontWeight="Bold"/>
                                </Border>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="30"/><TextBlock Text="Notifications" VerticalAlignment="Center"/></StackPanel>
                            </DockPanel>
                        </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="42,34,42,36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Border Width="42" Height="42" Background="#E8F0EF" CornerRadius="21">
                    <TextBlock Text="A" Foreground="#0D5558" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Administrator" FontWeight="SemiBold"/>
                    <TextBlock Text="{x:Static helpers:AppSession.CurrentDisplayName}" Foreground="#66727D" FontSize="12"/>
                </StackPanel>
                <Button Content="⏻" Click="SignOutButton_Click" Margin="18,0,0,0" Width="36" Height="36"
                        Background="#0F4C5C" Foreground="White" FontSize="20" ToolTip="Sign out"
                        BorderThickness="0" Padding="0" Cursor="Hand"/>
            </StackPanel>

            <Frame x:Name="MainContentFrame" Grid.Row="1" Margin="0,30,0,0" NavigationUIVisibility="Hidden" />
        </Grid>
    </Grid>
</Window>
