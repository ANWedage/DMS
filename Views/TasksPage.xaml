<Page x:Class="DMS.Views.TasksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Task Management">
    <Grid Background="#E8EDEF">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#F8FBFB" BorderBrush="#DDE3E5" BorderThickness="1" CornerRadius="10" Padding="20,16" Margin="0,0,0,16">
            <Grid>
                <StackPanel>
                    <TextBlock Text="TASK MANAGEMENT" Foreground="#126E70" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="Projects and daily delivery" FontSize="30" FontWeight="Bold" Foreground="#17212B" Margin="0,3,0,0"/>
                    <TextBlock Text="Create projects, organize components, assign members, and review daily progress." Margin="0,5,0,0" Foreground="#66727D" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                    <Border Background="#E8F0EF" CornerRadius="6" Padding="10,7">
                        <TextBlock Text="ADMIN WORKSPACE" Foreground="#0D5558" FontSize="11" FontWeight="Bold"/>
                    </Border>
                    <Button Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" Width="38" Height="38" Margin="10,0,0,0"
                            Click="RefreshButton_Click" ToolTip="Refresh project list"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#F8FBFB" Padding="16" BorderBrush="#DDE3E5" BorderThickness="1" CornerRadius="10">
                <DockPanel>
                    <Expander DockPanel.Dock="Top" Header="Create New Project" IsExpanded="False" Margin="0,0,0,12" FontWeight="SemiBold">
                        <StackPanel>
                            <TextBlock Text="Enter the project details and choose its starting status." Foreground="#66727D" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="Project name" FontWeight="SemiBold" Margin="0,12,0,0"/>
                            <TextBox x:Name="ProjectNameTextBox" Margin="0,10,0,0" ToolTip="Project name"/>
                            <TextBlock Text="Description" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            <TextBox x:Name="ProjectDescriptionTextBox" Height="58" Margin="0,8,0,0" AcceptsReturn="True" TextWrapping="Wrap" ToolTip="Project description"/>
                            <TextBlock Text="Dates" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <DatePicker x:Name="ProjectStartDatePicker" Width="118"/>
                                <DatePicker x:Name="ProjectDueDatePicker" Width="118" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="Status" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            <ComboBox x:Name="ProjectStatusComboBox" Margin="0,8,0,0">
                                <ComboBoxItem Content="Draft"/><ComboBoxItem Content="Active"/><ComboBoxItem Content="Completed"/><ComboBoxItem Content="Archived"/>
                            </ComboBox>
                            <Button Content="Create Project" Click="CreateProjectButton_Click" Margin="0,10,0,16"/>
                        </StackPanel>
                    </Expander>
                    <Expander Header="View Projects" IsExpanded="False" FontWeight="SemiBold" ToolTip="Expand to select a project">
                        <StackPanel>
                            <TextBlock Text="Expand to view and select a project." Foreground="#66727D" TextWrapping="Wrap" Margin="0,4,0,10"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ListBox x:Name="ProjectListBox" SelectionChanged="ProjectListBox_SelectionChanged" BorderThickness="0">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="82" Padding="10" CornerRadius="6">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FFFFFF"/>
                                                <Setter Property="BorderBrush" Value="#DDE3E5"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#E5F4F2"/>
                                                        <Setter Property="BorderBrush" Value="#126E70"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Row="1" Orientation="Horizontal">
                                                <TextBlock Text="{Binding Status}" Foreground="#126E70" FontSize="12"/>
                                                <TextBlock Text="{Binding DueDate, StringFormat=  |  Due: {0:d}}" Foreground="#66727D" FontSize="12"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Grid.RowSpan="2" Content="✕" Tag="{Binding Id}" Click="DeleteProjectButton_Click" Width="24" Height="24" Padding="0" Background="#B3261E" Foreground="White" BorderThickness="0" ToolTip="Delete project and all related task data" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                        </StackPanel>
                    </Expander>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Background="#FFFFFF" Padding="22" BorderBrush="#DDE3E5" BorderThickness="1" CornerRadius="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="SELECTED PROJECT" Foreground="#126E70" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SelectedProjectText" Text="Select a project" FontSize="26" FontWeight="Bold" Margin="0,3,0,0"/>
                        <TextBlock x:Name="SelectedProjectDescriptionText" Foreground="#66727D" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="Project details" FontSize="17" FontWeight="SemiBold" Margin="0,16,0,0"/>
                        <TextBlock Text="Update project information or change its status." Foreground="#66727D" Margin="0,4,0,0"/>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="EditProjectNameTextBox" Grid.Column="0" ToolTip="Project name"/>
                            <TextBox x:Name="EditProjectDescriptionTextBox" Grid.Column="1" Margin="8,0,0,0" ToolTip="Project description"/>
                            <DatePicker x:Name="EditProjectStartDatePicker" Grid.Column="2" Margin="8,0,0,0"/>
                            <DatePicker x:Name="EditProjectDueDatePicker" Grid.Column="3" Margin="8,0,0,0"/>
                            <ComboBox x:Name="EditProjectStatusComboBox" Grid.Column="4" Margin="8,0,0,0">
                                <ComboBoxItem Content="Draft"/><ComboBoxItem Content="Active"/><ComboBoxItem Content="Completed"/><ComboBoxItem Content="Archived"/>
                            </ComboBox>
                        </Grid>
                        <Button Content="Update Project" Click="UpdateProjectButton_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="#F5F8F7" BorderBrush="#DCE8E5" BorderThickness="1" Padding="16" Margin="0,18,0,18" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Add New Component" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="Create a work item for this project." Foreground="#66727D" Margin="0,4,0,0"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="130"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="ComponentNameTextBox" Grid.Column="0" ToolTip="Component name"/>
                                <TextBox x:Name="ComponentDescriptionTextBox" Grid.Column="1" Margin="8,0,0,0" ToolTip="Description"/>
                                <ComboBox x:Name="ComponentPriorityComboBox" Grid.Column="2" Margin="8,0,0,0">
                                    <ComboBoxItem Content="Low"/><ComboBoxItem Content="Medium"/><ComboBoxItem Content="High"/>
                                </ComboBox>
                                <DatePicker x:Name="ComponentDueDatePicker" Grid.Column="3" Margin="8,0,0,0"/>
                                <Button Grid.Column="4" Content="Add" Click="AddComponentButton_Click" Margin="8,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Row="2">
                        <Grid Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="COMPONENTS" Foreground="#126E70" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="Project work items" FontSize="19" FontWeight="SemiBold" Margin="0,3,0,0"/>
                            </StackPanel>
                            <TextBlock Text="Select a row to edit details and assignments" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="#66727D" FontSize="12"/>
                        </Grid>
                        <ListView x:Name="ComponentListView" Height="280" SelectionChanged="ComponentListView_SelectionChanged" BorderThickness="0" Background="Transparent">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="7" Padding="14,11">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FFFFFF"/>
                                                <Setter Property="BorderBrush" Value="#DDE3E5"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#E5F4F2"/>
                                                        <Setter Property="BorderBrush" Value="#126E70"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="125"/><ColumnDefinition Width="125"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="#17212B"/>
                                                <TextBlock Text="{Binding Description}" Foreground="#66727D" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="PRIORITY" Foreground="#88949B" FontSize="10" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Priority}" Foreground="#126E70" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="DUE DATE" Foreground="#88949B" FontSize="10" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding DueDate, StringFormat=d}" Foreground="#17212B" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                <TextBlock Text="STATUS" Foreground="#88949B" FontSize="10" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Status}" Foreground="#126E70" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="4" Tag="{Binding}" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Width="32" Height="32" Padding="0" Background="#FCEBE7" Foreground="#B54736" ToolTip="Delete component" Click="DeleteComponentButton_Click" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Expander x:Name="ComponentWorkspaceExpander" Header="Selected Component Workspace" IsExpanded="True" Margin="0,16,0,0" FontWeight="SemiBold">
                            <Border Background="#F7F9F9" Padding="16" BorderBrush="#DDE3E5" BorderThickness="1" CornerRadius="8">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="SelectedComponentText" Text="Select a component" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Text="Edit component details and status." Foreground="#66727D" Margin="0,4,0,0"/>
                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="120"/><ColumnDefinition Width="130"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox x:Name="EditComponentNameTextBox" Grid.Column="0" ToolTip="Component name"/>
                                            <TextBox x:Name="EditComponentDescriptionTextBox" Grid.Column="1" Margin="8,0,0,0" ToolTip="Component description"/>
                                            <ComboBox x:Name="EditComponentPriorityComboBox" Grid.Column="2" Margin="8,0,0,0">
                                                <ComboBoxItem Content="Low"/><ComboBoxItem Content="Medium"/><ComboBoxItem Content="High"/>
                                            </ComboBox>
                                            <ComboBox x:Name="EditComponentStatusComboBox" Grid.Column="3" Margin="8,0,0,0">
                                                <ComboBoxItem Content="Not started"/><ComboBoxItem Content="In progress"/><ComboBoxItem Content="Blocked"/><ComboBoxItem Content="Completed"/>
                                            </ComboBox>
                                            <DatePicker x:Name="EditComponentDueDatePicker" Grid.Column="4" Margin="8,0,0,0"/>
                                            <Button Grid.Column="5" Content="Update Component" Click="UpdateComponentButton_Click" Margin="8,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                    <Grid Grid.Row="1" Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Assign Members" FontSize="17" FontWeight="SemiBold"/>
                                            <TextBlock Text="Select one or more active members." Foreground="#66727D" Margin="0,4,0,6"/>
                                            <ListBox x:Name="MembersListBox" Height="145" BorderThickness="0">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Checked="MemberCheckBox_Checked" Unchecked="MemberCheckBox_Unchecked" Padding="4"/>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <Button Content="Save Assignments" Click="SaveAssignmentsButton_Click" Margin="0,10,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Track Daily Updates" FontSize="17" FontWeight="SemiBold"/>
                                            <TextBlock Text="Review work descriptions submitted by assigned members." Foreground="#66727D" Margin="0,4,0,6"/>
                                            <Button Content="View Daily Updates" Click="ViewUpdatesButton_Click" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Grid>
                                    <ListView Grid.Row="2" x:Name="UpdatesListView" Height="220" Margin="0,18,0,0" BorderThickness="0">
                                        <ListView.View><GridView>
                                            <GridViewColumn Header="User" DisplayMemberBinding="{Binding UserName}" Width="170"/>
                                            <GridViewColumn Header="Date" DisplayMemberBinding="{Binding UpdateDate, StringFormat=d}" Width="100"/>
                                            <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="120"/>
                                            <GridViewColumn Header="Today's Work" DisplayMemberBinding="{Binding Description}" Width="520"/>
                                        </GridView></ListView.View>
                                    </ListView>
                                </Grid>
                            </Border>
                        </Expander>
                        <Border Background="White" BorderBrush="#DDE3E5" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="PROJECT DAILY REPORT" Foreground="#126E70" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="Project Daily Report" FontSize="19" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                <TextBlock Text="View every component and assigned member update for one date, then generate one report." Foreground="#66727D" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,12">
                                    <TextBlock Text="Report date" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <DatePicker x:Name="ProjectReportDatePicker" Width="130"/>
                                    <Button Content="Load Project Report" Click="LoadProjectReportButton_Click" Margin="10,0,0,0"/>
                                    <Button Content="Generate PDF Report" Click="GenerateProjectReportButton_Click" Margin="10,0,0,0"/>
                                </StackPanel>
                                <DataGrid x:Name="ProjectReportGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="300" Background="White" BorderBrush="#DDE3E5" BorderThickness="1">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Component" Binding="{Binding ComponentName}" Width="170"/>
                                        <DataGridTextColumn Header="Description" Binding="{Binding ComponentDescription}" Width="240"/>
                                        <DataGridTextColumn Header="Member" Binding="{Binding UserName}" Width="150"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                                        <DataGridTextColumn Header="Today's Work" Binding="{Binding DailyWork}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock x:Name="ProjectReportMessageText" Foreground="#66727D" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="#DDE3E5" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="SELF STUDY REPORT" Foreground="#126E70" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="Self Study Daily Report" FontSize="19" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                <TextBlock Text="Review self study entries submitted by team members for a selected date." Foreground="#66727D" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,12">
                                    <TextBlock Text="Report date" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <DatePicker x:Name="SelfStudyReportDatePicker" Width="130"/>
                                    <Button Content="Load Self Study Report" Click="LoadSelfStudyReportButton_Click" Margin="10,0,0,0"/>
                                    <Button Content="Generate PDF Report" Click="GenerateSelfStudyReportButton_Click" Margin="10,0,0,0"/>
                                </StackPanel>
                                <DataGrid x:Name="SelfStudyReportGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="300" Background="White" BorderBrush="#DDE3E5" BorderThickness="1">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Member" Binding="{Binding UserName}" Width="170"/>
                                        <DataGridTextColumn Header="Date" Binding="{Binding UpdateDate, StringFormat=d}" Width="110"/>
                                        <DataGridTextColumn Header="Topic" Binding="{Binding Topic}" Width="170"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                                        <DataGridTextColumn Header="Study Notes" Binding="{Binding Description}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock x:Name="SelfStudyReportMessageText" Foreground="#66727D" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
