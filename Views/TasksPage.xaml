<Page x:Class="DMS.Views.TasksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Task Management">
    <Grid Background="#E8EDEF">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Task Management" FontSize="32" FontWeight="Bold" Foreground="#17212B"/>
            <TextBlock Text="Create projects, split work into components, and assign each component to one or more members." Margin="0,8,0,0" Foreground="#66727D" TextWrapping="Wrap"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="285"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" Padding="16" BorderBrush="#DDE3E5" BorderThickness="1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Create New Project" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Enter the project details and choose its starting status." Foreground="#66727D" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="Project name" FontWeight="SemiBold" Margin="0,12,0,0"/>
                        <TextBox x:Name="ProjectNameTextBox" Margin="0,10,0,0" ToolTip="Project name"/>
                        <TextBlock Text="Description" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        <TextBox x:Name="ProjectDescriptionTextBox" Height="58" Margin="0,8,0,0" AcceptsReturn="True" TextWrapping="Wrap" ToolTip="Project description"/>
                        <TextBlock Text="Dates" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <DatePicker x:Name="ProjectStartDatePicker" Width="118"/>
                            <DatePicker x:Name="ProjectDueDatePicker" Width="118" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="Status" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        <ComboBox x:Name="ProjectStatusComboBox" Margin="0,8,0,0">
                            <ComboBoxItem Content="Draft"/><ComboBoxItem Content="Active"/><ComboBoxItem Content="Completed"/><ComboBoxItem Content="Archived"/>
                        </ComboBox>
                        <Button Content="Create Project" Click="CreateProjectButton_Click" Margin="0,10,0,16"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ListBox x:Name="ProjectListBox" SelectionChanged="ProjectListBox_SelectionChanged" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10" Margin="0,0,0,8" BorderBrush="#DDE3E5" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"/>
                                            <TextBlock Text="{Binding Description}" Foreground="#66727D" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding Status}" Foreground="#126E70" Margin="0,4,0,0"/>
                                            <Grid Margin="0,3,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding DueDate, StringFormat=Due: {0:d}}" Foreground="#66727D" FontSize="12" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="✕" Tag="{Binding Id}" Click="DeleteProjectButton_Click" Width="24" Height="24" Padding="0" Background="#B3261E" Foreground="White" BorderThickness="0" ToolTip="Delete project and all related task data"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Background="White" Padding="18" BorderBrush="#DDE3E5" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="SelectedProjectText" Text="Select a project" FontSize="22" FontWeight="Bold"/>
                        <TextBlock x:Name="SelectedProjectDescriptionText" Foreground="#66727D" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="Edit Project" FontSize="17" FontWeight="SemiBold" Margin="0,14,0,0"/>
                        <TextBlock Text="Update project information or change its status." Foreground="#66727D" Margin="0,4,0,0"/>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="EditProjectNameTextBox" Grid.Column="0" ToolTip="Project name"/>
                            <TextBox x:Name="EditProjectDescriptionTextBox" Grid.Column="1" Margin="8,0,0,0" ToolTip="Project description"/>
                            <DatePicker x:Name="EditProjectStartDatePicker" Grid.Column="2" Margin="8,0,0,0"/>
                            <DatePicker x:Name="EditProjectDueDatePicker" Grid.Column="3" Margin="8,0,0,0"/>
                            <ComboBox x:Name="EditProjectStatusComboBox" Grid.Column="4" Margin="8,0,0,0">
                                <ComboBoxItem Content="Draft"/><ComboBoxItem Content="Active"/><ComboBoxItem Content="Completed"/><ComboBoxItem Content="Archived"/>
                            </ComboBox>
                        </Grid>
                        <Button Content="Update Project" Click="UpdateProjectButton_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="#F7F9F9" Padding="12" Margin="0,16,0,16">
                        <StackPanel>
                            <TextBlock Text="Add New Component" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="Create a work item for this project." Foreground="#66727D" Margin="0,4,0,0"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="130"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="ComponentNameTextBox" Grid.Column="0" ToolTip="Component name"/>
                                <TextBox x:Name="ComponentDescriptionTextBox" Grid.Column="1" Margin="8,0,0,0" ToolTip="Description"/>
                                <ComboBox x:Name="ComponentPriorityComboBox" Grid.Column="2" Margin="8,0,0,0">
                                    <ComboBoxItem Content="Low"/><ComboBoxItem Content="Medium"/><ComboBoxItem Content="High"/>
                                </ComboBox>
                                <DatePicker x:Name="ComponentDueDatePicker" Grid.Column="3" Margin="8,0,0,0"/>
                                <Button Grid.Column="4" Content="Add" Click="AddComponentButton_Click" Margin="8,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="Project Components" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ListView x:Name="ComponentListView" Height="220" SelectionChanged="ComponentListView_SelectionChanged" BorderThickness="0">
                            <ListView.View><GridView>
                                <GridViewColumn Header="Component" DisplayMemberBinding="{Binding Name}" Width="170"/>
                                <GridViewColumn Header="Description" DisplayMemberBinding="{Binding Description}" Width="300"/>
                                <GridViewColumn Header="Priority" DisplayMemberBinding="{Binding Priority}" Width="95"/>
                                <GridViewColumn Header="Due" DisplayMemberBinding="{Binding DueDate, StringFormat=d}" Width="110"/>
                                <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="130"/>
                            </GridView></ListView.View>
                        </ListView>
                        <Expander x:Name="ComponentWorkspaceExpander" Header="Selected Component Workspace" IsExpanded="True" Margin="0,16,0,0">
                            <Border Background="#F7F9F9" Padding="16" BorderBrush="#DDE3E5" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="SelectedComponentText" Text="Select a component" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Text="Edit component details and status." Foreground="#66727D" Margin="0,4,0,0"/>
                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="120"/><ColumnDefinition Width="130"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox x:Name="EditComponentNameTextBox" Grid.Column="0" ToolTip="Component name"/>
                                            <TextBox x:Name="EditComponentDescriptionTextBox" Grid.Column="1" Margin="8,0,0,0" ToolTip="Component description"/>
                                            <ComboBox x:Name="EditComponentPriorityComboBox" Grid.Column="2" Margin="8,0,0,0">
                                                <ComboBoxItem Content="Low"/><ComboBoxItem Content="Medium"/><ComboBoxItem Content="High"/>
                                            </ComboBox>
                                            <ComboBox x:Name="EditComponentStatusComboBox" Grid.Column="3" Margin="8,0,0,0">
                                                <ComboBoxItem Content="Not started"/><ComboBoxItem Content="In progress"/><ComboBoxItem Content="Blocked"/><ComboBoxItem Content="Completed"/>
                                            </ComboBox>
                                            <DatePicker x:Name="EditComponentDueDatePicker" Grid.Column="4" Margin="8,0,0,0"/>
                                            <Button Grid.Column="5" Content="Update Component" Click="UpdateComponentButton_Click" Margin="8,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                    <Grid Grid.Row="1" Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Assign Members" FontSize="17" FontWeight="SemiBold"/>
                                            <TextBlock Text="Select one or more active members." Foreground="#66727D" Margin="0,4,0,6"/>
                                            <ListBox x:Name="MembersListBox" Height="145" BorderThickness="0">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Padding="4"/>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <Button Content="Save Assignments" Click="SaveAssignmentsButton_Click" Margin="0,10,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Track Daily Updates" FontSize="17" FontWeight="SemiBold"/>
                                            <TextBlock Text="Review work descriptions submitted by assigned members." Foreground="#66727D" Margin="0,4,0,6"/>
                                            <Button Content="View Daily Updates" Click="ViewUpdatesButton_Click" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Grid>
                                    <ListView Grid.Row="2" x:Name="UpdatesListView" Height="190" Margin="0,18,0,0" BorderThickness="0">
                                        <ListView.View><GridView>
                                            <GridViewColumn Header="User" DisplayMemberBinding="{Binding UserName}" Width="170"/>
                                            <GridViewColumn Header="Date" DisplayMemberBinding="{Binding UpdateDate, StringFormat=d}" Width="100"/>
                                            <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="120"/>
                                            <GridViewColumn Header="Today's Work" DisplayMemberBinding="{Binding Description}" Width="520"/>
                                        </GridView></ListView.View>
                                    </ListView>
                                </Grid>
                            </Border>
                        </Expander>
                        <Border Background="White" BorderBrush="#DDE3E5" BorderThickness="1" Padding="16" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Project Daily Report" FontSize="19" FontWeight="SemiBold"/>
                                <TextBlock Text="View every component and assigned member update for one date, then generate one report." Foreground="#66727D" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,12">
                                    <TextBlock Text="Report date" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <DatePicker x:Name="ProjectReportDatePicker" Width="130"/>
                                    <Button Content="Load Project Report" Click="LoadProjectReportButton_Click" Margin="10,0,0,0"/>
                                    <Button Content="Generate PDF Report" Click="GenerateProjectReportButton_Click" Margin="10,0,0,0"/>
                                </StackPanel>
                                <DataGrid x:Name="ProjectReportGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="260" Background="White" BorderBrush="#DDE3E5" BorderThickness="1">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Component" Binding="{Binding ComponentName}" Width="170"/>
                                        <DataGridTextColumn Header="Description" Binding="{Binding ComponentDescription}" Width="240"/>
                                        <DataGridTextColumn Header="Member" Binding="{Binding UserName}" Width="150"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                                        <DataGridTextColumn Header="Today's Work" Binding="{Binding DailyWork}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock x:Name="ProjectReportMessageText" Foreground="#66727D" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
