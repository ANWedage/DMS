<Window x:Class="DMS.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DMS | Workspace"
        Icon="/Assets/dms-logo.png"
        Height="680" Width="1120"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#E8EDEF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#12343D" Padding="26,28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="DMS" Foreground="White" FontSize="26" FontWeight="Bold"/>
                <StackPanel Grid.Row="2">
                    <Button Height="42" Margin="0,0,0,8"
                        Background="#1F5962" Foreground="White" HorizontalContentAlignment="Left"
                        Padding="12,0" Click="AttendanceButton_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28"/><TextBlock Text="Attendance" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button Height="42" Margin="0,0,0,8"
                        Background="#1F5962" Foreground="White" HorizontalContentAlignment="Left"
                        Padding="12,0" Click="MyTasksButton_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28"/><TextBlock Text="My Tasks" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button Height="42" Margin="0,0,0,8"
                        Background="#1F5962" Foreground="White" HorizontalContentAlignment="Left"
                        Padding="12,0" Click="DailyTaskFormButton_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28"/><TextBlock Text="Open daily task form" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button Height="42" Margin="0,0,0,8"
                        Background="#1F5962" Foreground="White" HorizontalContentAlignment="Left"
                        Padding="12,0" Click="LeaveFormButton_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28"/><TextBlock Text="Open leave form" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button Height="42" Margin="0,0,0,8"
                        Background="#1F5962" Foreground="White" HorizontalContentAlignment="Left"
                        Padding="12,0" Click="ChatButton_Click">
                        <DockPanel>
                            <Border x:Name="UserChatBadge" DockPanel.Dock="Right" Background="#E97858" CornerRadius="10" Padding="7,2" Margin="10,0,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="UserChatCountText" Foreground="White" FontWeight="Bold"/>
                            </Border>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28"/><TextBlock Text="Chat" VerticalAlignment="Center"/></StackPanel>
                        </DockPanel>
                    </Button>
                    <Button Height="42" Background="#1F5962" Foreground="White" HorizontalContentAlignment="Left"
                        Padding="12,0" Click="NotificationsButton_Click">
                        <DockPanel>
                            <Border x:Name="UserNotificationBadge" DockPanel.Dock="Right" Background="#E97858" CornerRadius="10" Padding="7,2" Margin="10,0,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="UserNotificationCountText" Foreground="White" FontWeight="Bold"/>
                            </Border>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28"/><TextBlock Text="Notifications" VerticalAlignment="Center"/></StackPanel>
                        </DockPanel>
                    </Button>
                </StackPanel>
                
                <Button Grid.Row="5" Height="42" Margin="0,0,0,12" VerticalAlignment="Bottom" Background="#1F5962" Foreground="White"
                    HorizontalContentAlignment="Left" Padding="12,0" Click="SettingsButton_Click" ToolTip="Open profile settings">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28"/><TextBlock Text="Settings" VerticalAlignment="Center"/></StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="42,34,42,36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#F8FBFB" BorderBrush="#B7D6DD" BorderThickness="1" CornerRadius="8" Padding="12,7">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Username}" Foreground="#17212B" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Email}" Style="{StaticResource MutedStyle}" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Button Content="⏻" Click="SignOutButton_Click" Margin="16,2,0,0"
                            Width="36" Height="36" Padding="0" FontSize="20"
                            Background="#0F4C5C" Foreground="White" BorderThickness="0"
                            Cursor="Hand" ToolTip="Sign out"/>
                </StackPanel>
            </Grid>

            <Border x:Name="UserTaskReminderBanner" Grid.Row="1" Margin="0,16,0,0" Visibility="Collapsed" BorderBrush="#D64545" BorderThickness="3" CornerRadius="14" Padding="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FFF8DF" Offset="0"/>
                        <GradientStop Color="#FFE0A8" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.28" Color="#8A5A00"/>
                </Border.Effect>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.22"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="68"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#D64545" CornerRadius="10,0,0,10">
                        <TextBlock Text="!" Foreground="White" FontSize="30" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="18,14,18,14">
                        <TextBlock Text="Daily task reminder" Foreground="#6D2B1B" FontWeight="Bold" FontSize="18"/>
                        <TextBlock Text="Complete and submit your task update before the workday ends." Foreground="#6D2B1B" Margin="0,4,0,0" FontSize="14" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

                 <Frame x:Name="MainContentFrame" Grid.Row="2" Margin="0,30,0,0"
                     NavigationUIVisibility="Hidden"/>

                 <TextBlock Grid.Row="3" Text="Developed By Adeepa Wedage" Foreground="#1A3D45"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,12,0,0"/>
        </Grid>
    </Grid>
</Window>
