<Window x:Class="DMS.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DMS | Workspace"
        Icon="/Assets/dms-logo.png"
        Height="680" Width="1120"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource TealBrush}" Padding="26,28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="DMS" Foreground="White" FontSize="26" FontWeight="Bold"/>
                <StackPanel Grid.Row="2">
                    <Button Content="Dashboard" Height="42" Margin="0,0,0,8"
                        Background="#2B8585" Foreground="White" HorizontalContentAlignment="Left"
                        Padding="12,0" Click="DashboardButton_Click"/>
                    <Button Content="Attendance" Height="42" Margin="0,0,0,8"
                        Background="#2B8585" Foreground="White" HorizontalContentAlignment="Left"
                        Padding="12,0" Click="AttendanceButton_Click"/>
                    <Button Content="My Tasks" Height="42" Margin="0,0,0,8"
                        Background="#2B8585" Foreground="White" HorizontalContentAlignment="Left"
                        Padding="12,0" Click="MyTasksButton_Click"/>
                    <Button Content="Notifications" Height="42"
                        Background="#2B8585" Foreground="White" HorizontalContentAlignment="Left"
                        Padding="12,0" Click="NotificationsButton_Click"/>
                </StackPanel>
                
                <TextBlock Grid.Row="6" Text="Created By Adeepa Wedage" Foreground="#D7EFEC"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="42,34,42,36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38" Height="38" Background="#E8F0EF" CornerRadius="19">
                            <TextBlock Text="{Binding Initials}" Foreground="{StaticResource TealDarkBrush}"
                                       FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Username}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Email}" Style="{StaticResource MutedStyle}" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Content="⏻" Click="SignOutButton_Click" Margin="16,2,0,0"
                            Width="36" Height="36" Padding="0" FontSize="20"
                            Background="#0F4C5C" Foreground="White" BorderThickness="0"
                            Cursor="Hand" ToolTip="Sign out"/>
                </StackPanel>
            </Grid>

                 <Frame x:Name="MainContentFrame" Grid.Row="1" Margin="0,30,0,0"
                     NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Window>
