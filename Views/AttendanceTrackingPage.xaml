<Page x:Class="DMS.Views.AttendanceTrackingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Track Attendance">
    <Grid Background="#E8EDEF">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30">
                <TextBlock Text="Track Attendance" Style="{StaticResource HeadingStyle}"/>
                <TextBlock Text="Review attendance for the scheduled meetings."
                           Margin="0,8,0,20" Foreground="#66727D"/>

                <Border Background="White" BorderBrush="#DDE3E5" BorderThickness="1" CornerRadius="10" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Meeting settings" Style="{StaticResource SectionHeadingStyle}"/>
                        <TextBlock Text="Full Stack" FontWeight="SemiBold" Margin="0,14,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Morning time" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,18,8">
                                <ComboBox x:Name="FullStackMorningHourBox" Width="58" ToolTip="Hour"/>
                                <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0"/>
                                <ComboBox x:Name="FullStackMorningMinuteBox" Width="58" ToolTip="Minute"/>
                            </StackPanel>
                            <TextBox x:Name="FullStackMorningLinkTextBox" Grid.Column="2" Margin="0,0,8,8" ToolTip="Google Meet link"/>
                            <Button x:Name="FullStackMorningJoinButton" Grid.Column="3" Content="Join Meet" Tag="FullStackMorning" Click="JoinMeetingButton_Click" Margin="0,0,0,8" IsEnabled="False"/>
                            <TextBlock Text="Evening time" Grid.Row="1" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="8,0,18,0">
                                <ComboBox x:Name="FullStackEveningHourBox" Width="58" ToolTip="Hour"/>
                                <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0"/>
                                <ComboBox x:Name="FullStackEveningMinuteBox" Width="58" ToolTip="Minute"/>
                            </StackPanel>
                            <TextBox x:Name="FullStackEveningLinkTextBox" Grid.Row="1" Grid.Column="2" Margin="0,0,8,0" ToolTip="Google Meet link"/>
                            <Button x:Name="FullStackEveningJoinButton" Grid.Row="1" Grid.Column="3" Content="Join Meet" Tag="FullStackEvening" Click="JoinMeetingButton_Click" IsEnabled="False"/>
                        </Grid>
                        <TextBlock Text="QA" FontWeight="SemiBold" Margin="0,14,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Morning time" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,18,8">
                                <ComboBox x:Name="QaMorningHourBox" Width="58" ToolTip="Hour"/>
                                <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0"/>
                                <ComboBox x:Name="QaMorningMinuteBox" Width="58" ToolTip="Minute"/>
                            </StackPanel>
                            <TextBox x:Name="QaMorningLinkTextBox" Grid.Column="2" Margin="0,0,8,8" ToolTip="Google Meet link"/>
                            <Button x:Name="QaMorningJoinButton" Grid.Column="3" Content="Join Meet" Tag="QaMorning" Click="JoinMeetingButton_Click" Margin="0,0,0,8" IsEnabled="False"/>
                            <TextBlock Text="Evening time" Grid.Row="1" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="8,0,18,0">
                                <ComboBox x:Name="QaEveningHourBox" Width="58" ToolTip="Hour"/>
                                <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0"/>
                                <ComboBox x:Name="QaEveningMinuteBox" Width="58" ToolTip="Minute"/>
                            </StackPanel>
                            <TextBox x:Name="QaEveningLinkTextBox" Grid.Row="1" Grid.Column="2" Margin="0,0,8,0" ToolTip="Google Meet link"/>
                            <Button x:Name="QaEveningJoinButton" Grid.Row="1" Grid.Column="3" Content="Join Meet" Tag="QaEvening" Click="JoinMeetingButton_Click" IsEnabled="False"/>
                        </Grid>
                        <TextBlock Text="UI/UX" FontWeight="SemiBold" Margin="0,14,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Morning time" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,18,8">
                                <ComboBox x:Name="UiUxMorningHourBox" Width="58" ToolTip="Hour"/>
                                <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0"/>
                                <ComboBox x:Name="UiUxMorningMinuteBox" Width="58" ToolTip="Minute"/>
                            </StackPanel>
                            <TextBox x:Name="UiUxMorningLinkTextBox" Grid.Column="2" Margin="0,0,8,8" ToolTip="Google Meet link"/>
                            <Button x:Name="UiUxMorningJoinButton" Grid.Column="3" Content="Join Meet" Tag="UiUxMorning" Click="JoinMeetingButton_Click" Margin="0,0,0,8" IsEnabled="False"/>
                            <TextBlock Text="Evening time" Grid.Row="1" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="8,0,18,0">
                                <ComboBox x:Name="UiUxEveningHourBox" Width="58" ToolTip="Hour"/>
                                <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0"/>
                                <ComboBox x:Name="UiUxEveningMinuteBox" Width="58" ToolTip="Minute"/>
                            </StackPanel>
                            <TextBox x:Name="UiUxEveningLinkTextBox" Grid.Row="1" Grid.Column="2" Margin="0,0,8,0" ToolTip="Google Meet link"/>
                            <Button x:Name="UiUxEveningJoinButton" Grid.Row="1" Grid.Column="3" Content="Join Meet" Tag="UiUxEvening" Click="JoinMeetingButton_Click" IsEnabled="False"/>
                        </Grid>
                        <TextBlock Text="Shared weekly meeting" FontWeight="SemiBold" Margin="0,14,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Weekly time" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,18,0">
                                <ComboBox x:Name="WeeklyHourBox" Width="58" ToolTip="Hour"/>
                                <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0"/>
                                <ComboBox x:Name="WeeklyMinuteBox" Width="58" ToolTip="Minute"/>
                            </StackPanel>
                            <TextBox x:Name="WeeklyLinkTextBox" Grid.Column="2" Margin="0,0,8,0" ToolTip="Google Meet link"/>
                            <Button x:Name="WeeklyJoinButton" Grid.Column="3" Content="Join Meet" Tag="Weekly" Click="JoinMeetingButton_Click" IsEnabled="False"/>
                        </Grid>
                        <Button Content="Save meeting settings" Click="SaveSettingsButton_Click"
                                HorizontalAlignment="Left" Margin="0,14,0,0"/>
                        <TextBlock x:Name="LastSettingsUpdateText" Margin="0,10,0,0"
                               Foreground="#66727D" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SettingsMessageText" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,20,0,10">
                    <TextBlock Text="Attendance date" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <DatePicker x:Name="AttendanceDatePicker" SelectedDateChanged="AttendanceDatePicker_SelectedDateChanged"/>
                    <Button Content="Refresh" Click="RefreshButton_Click" Margin="10,0,0,0"/>
                    <Button Content="Generate PDF report" Click="GenerateReportButton_Click" Margin="10,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="AttendanceMessageText" Margin="0,0,0,10" TextWrapping="Wrap"/>

                <Border Background="White" BorderBrush="#DDE3E5" BorderThickness="1" CornerRadius="10">
                    <DataGrid x:Name="AttendanceGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="False" Background="Transparent" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Team" Binding="{Binding Team}" IsReadOnly="True" Width="100"/>
                        <DataGridTextColumn Header="Member" Binding="{Binding MemberName}" IsReadOnly="True" Width="170"/>
                        <DataGridTextColumn Header="Meeting" Binding="{Binding MeetingType}" IsReadOnly="True" Width="100"/>
                        <DataGridTextColumn Header="Marked by" Binding="{Binding MarkedByDisplay}" IsReadOnly="True" Width="120"/>
                        <DataGridTemplateColumn Header="Status" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4">
                                        <Border Padding="3" CornerRadius="3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E58A2B"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Present">
                                                            <Setter Property="Background" Value="#1FAE67"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Absent">
                                                            <Setter Property="Background" Value="#D85A5A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Absent (informed)">
                                                            <Setter Property="Background" Value="#E58A2B"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Leave">
                                                            <Setter Property="Background" Value="#7C6EF6"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding Status, UpdateSourceTrigger=PropertyChanged}"
                                                      Background="Transparent" BorderThickness="0"/>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Admin note" Binding="{Binding AdminNote, UpdateSourceTrigger=PropertyChanged}" Width="220"/>
                        <DataGridTemplateColumn Header="Action" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4">
                                        <Button Content="Save" Tag="{Binding}" Click="SaveAttendanceButton_Click" Padding="10,5"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
