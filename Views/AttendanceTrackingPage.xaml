<Page x:Class="DMS.Views.AttendanceTrackingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Track Attendance">
    <Grid Background="#E8EDEF" PreviewMouseWheel="Page_PreviewMouseWheel">
        <ScrollViewer x:Name="PageScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly"
                      CanContentScroll="False">
            <StackPanel Margin="30">
                <TextBlock Text="Track Attendance" Style="{StaticResource HeadingStyle}"/>
                <TextBlock Text="Review attendance for the scheduled meetings."
                           Margin="0,8,0,20" Foreground="#66727D"/>

                <Border Background="White" BorderBrush="#DDE3E5" BorderThickness="1" CornerRadius="10" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Meeting settings" Style="{StaticResource SectionHeadingStyle}"/>
                        <TextBlock Text="Full Stack" FontWeight="SemiBold" Margin="0,14,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Morning time (A.M)" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,18,8">
                                <ComboBox x:Name="FullStackMorningHourBox" Width="58" ToolTip="Hour"/>
                                <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0"/>
                                <ComboBox x:Name="FullStackMorningMinuteBox" Width="58" ToolTip="Minute"/>
                            </StackPanel>
                            <TextBox x:Name="FullStackMorningLinkTextBox" Grid.Column="2" Margin="0,0,8,8" ToolTip="Google Meet link"/>
                            <Button x:Name="FullStackMorningJoinButton" Grid.Column="3" Content="Join Meet" Tag="FullStackMorning" Click="JoinMeetingButton_Click" Margin="0,0,0,8" IsEnabled="False"/>
                            <TextBlock Text="Evening time (P.M)" Grid.Row="1" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="8,0,18,0">
                                <ComboBox x:Name="FullStackEveningHourBox" Width="58" ToolTip="Hour"/>
                                <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0"/>
                                <ComboBox x:Name="FullStackEveningMinuteBox" Width="58" ToolTip="Minute"/>
                            </StackPanel>
                            <TextBox x:Name="FullStackEveningLinkTextBox" Grid.Row="1" Grid.Column="2" Margin="0,0,8,0" ToolTip="Google Meet link"/>
                            <Button x:Name="FullStackEveningJoinButton" Grid.Row="1" Grid.Column="3" Content="Join Meet" Tag="FullStackEvening" Click="JoinMeetingButton_Click" IsEnabled="False"/>
                        </Grid>
                        <TextBlock Text="QA" FontWeight="SemiBold" Margin="0,14,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Morning time (A.M.)" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,18,8">
                                <ComboBox x:Name="QaMorningHourBox" Width="58" ToolTip="Hour"/>
                                <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0"/>
                                <ComboBox x:Name="QaMorningMinuteBox" Width="58" ToolTip="Minute"/>
                            </StackPanel>
                            <TextBox x:Name="QaMorningLinkTextBox" Grid.Column="2" Margin="0,0,8,8" ToolTip="Google Meet link"/>
                            <Button x:Name="QaMorningJoinButton" Grid.Column="3" Content="Join Meet" Tag="QaMorning" Click="JoinMeetingButton_Click" Margin="0,0,0,8" IsEnabled="False"/>
                            <TextBlock Text="Evening time (P.M.)" Grid.Row="1" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="8,0,18,0">
                                <ComboBox x:Name="QaEveningHourBox" Width="58" ToolTip="Hour"/>
                                <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0"/>
                                <ComboBox x:Name="QaEveningMinuteBox" Width="58" ToolTip="Minute"/>
                            </StackPanel>
                            <TextBox x:Name="QaEveningLinkTextBox" Grid.Row="1" Grid.Column="2" Margin="0,0,8,0" ToolTip="Google Meet link"/>
                            <Button x:Name="QaEveningJoinButton" Grid.Row="1" Grid.Column="3" Content="Join Meet" Tag="QaEvening" Click="JoinMeetingButton_Click" IsEnabled="False"/>
                        </Grid>
                        <TextBlock Text="UI/UX" FontWeight="SemiBold" Margin="0,14,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Morning time (A.M.)" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,18,8">
                                <ComboBox x:Name="UiUxMorningHourBox" Width="58" ToolTip="Hour"/>
                                <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0"/>
                                <ComboBox x:Name="UiUxMorningMinuteBox" Width="58" ToolTip="Minute"/>
                            </StackPanel>
                            <TextBox x:Name="UiUxMorningLinkTextBox" Grid.Column="2" Margin="0,0,8,8" ToolTip="Google Meet link"/>
                            <Button x:Name="UiUxMorningJoinButton" Grid.Column="3" Content="Join Meet" Tag="UiUxMorning" Click="JoinMeetingButton_Click" Margin="0,0,0,8" IsEnabled="False"/>
                            <TextBlock Text="Evening time (P.M.)" Grid.Row="1" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="8,0,18,0">
                                <ComboBox x:Name="UiUxEveningHourBox" Width="58" ToolTip="Hour"/>
                                <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0"/>
                                <ComboBox x:Name="UiUxEveningMinuteBox" Width="58" ToolTip="Minute"/>
                            </StackPanel>
                            <TextBox x:Name="UiUxEveningLinkTextBox" Grid.Row="1" Grid.Column="2" Margin="0,0,8,0" ToolTip="Google Meet link"/>
                            <Button x:Name="UiUxEveningJoinButton" Grid.Row="1" Grid.Column="3" Content="Join Meet" Tag="UiUxEvening" Click="JoinMeetingButton_Click" IsEnabled="False"/>
                        </Grid>
                        <TextBlock Text="Shared weekly meeting" FontWeight="SemiBold" Margin="0,14,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Weekly time (A.M.)" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,18,0">
                                <ComboBox x:Name="WeeklyHourBox" Width="58" ToolTip="Hour"/>
                                <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0"/>
                                <ComboBox x:Name="WeeklyMinuteBox" Width="58" ToolTip="Minute"/>
                            </StackPanel>
                            <TextBox x:Name="WeeklyLinkTextBox" Grid.Column="2" Margin="0,0,8,0" ToolTip="Google Meet link"/>
                            <Button x:Name="WeeklyJoinButton" Grid.Column="3" Content="Join Meet" Tag="Weekly" Click="JoinMeetingButton_Click" IsEnabled="False"/>
                        </Grid>
                        <Button Content="Save meeting settings" Click="SaveSettingsButton_Click"
                                HorizontalAlignment="Left" Margin="0,14,0,0"/>
                        <TextBlock x:Name="LastSettingsUpdateText" Margin="0,10,0,0"
                               Foreground="#66727D" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SettingsMessageText" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,20,0,10">
                    <TextBlock Text="Attendance date" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <DatePicker x:Name="AttendanceDatePicker" SelectedDateChanged="AttendanceDatePicker_SelectedDateChanged"/>
                    <StackPanel Margin="14,0,0,0">
                        <TextBlock Text="Position" FontSize="12"/>
                        <ComboBox x:Name="PositionFilterComboBox"
                                  Width="125"
                                  Height="30"
                                  SelectedIndex="0"
                                  SelectionChanged="PositionFilterComboBox_SelectionChanged"
                                  ToolTip="Filter attendance by developer position">
                            <ComboBoxItem Content="All positions"/>
                            <ComboBoxItem Content="QA"/>
                            <ComboBoxItem Content="UI/UX"/>
                            <ComboBoxItem Content="Full Stack"/>
                            <ComboBoxItem Content="Unassigned"/>
                        </ComboBox>
                    </StackPanel>
                    <Button x:Name="RefreshButton" Content="Refresh" Click="RefreshButton_Click" Margin="10,0,0,0"/>
                    <Button Content="Generate PDF report" Click="GenerateReportButton_Click" Margin="10,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="AttendanceMessageText" Margin="0,0,0,10" TextWrapping="Wrap"/>

                <Border HorizontalAlignment="Right" Margin="0,0,0,8" Padding="10,4"
                        Background="#E7F3F2" BorderBrush="#B7D6DD" BorderThickness="1" CornerRadius="10">
                    <TextBlock x:Name="AttendanceCountText" Text="Developers: 0"
                               Foreground="#12343D" FontSize="12" FontWeight="SemiBold"/>
                </Border>
                <Border Background="White" BorderBrush="#DDE3E5" BorderThickness="1" CornerRadius="10">
                    <DataGrid x:Name="AttendanceGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="False" Background="Transparent" BorderThickness="0">
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Team" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="10,4" CornerRadius="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#E5E7EB"/>
                                                <Setter Property="BorderBrush" Value="#D1D5DB"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Team}" Value="QA">
                                                        <Setter Property="Background" Value="#3BAA59"/>
                                                        <Setter Property="BorderBrush" Value="#2E8B4D"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Team}" Value="UI/UX">
                                                        <Setter Property="Background" Value="#8B5CF6"/>
                                                        <Setter Property="BorderBrush" Value="#7C3AED"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Team}" Value="Full Stack">
                                                        <Setter Property="Background" Value="#0EA5E9"/>
                                                        <Setter Property="BorderBrush" Value="#0284C7"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Team, FallbackValue='-'}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Member" Binding="{Binding MemberName}" IsReadOnly="True" Width="SizeToCells" MinWidth="170">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontSize" Value="15"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Meeting" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding AttendanceRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#DDE3E5" BorderThickness="0,0,0,1" MinHeight="48" Padding="6,4">
                                                    <TextBlock Text="{Binding MeetingType}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Marked by" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding AttendanceRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#DDE3E5" BorderThickness="0,0,0,1" MinHeight="48" Padding="6,4">
                                                    <TextBlock Text="{Binding MarkedByDisplay}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Status" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding AttendanceRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#DDE3E5" BorderThickness="0,0,0,1" MinHeight="48" Padding="4">
                                                    <Border CornerRadius="3" Padding="3" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#E58A2B"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Present">
                                                                        <Setter Property="Background" Value="#1FAE67"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Absent">
                                                                        <Setter Property="Background" Value="#D85A5A"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Absent (informed)">
                                                                        <Setter Property="Background" Value="#E58A2B"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Leave">
                                                                        <Setter Property="Background" Value="#7C6EF6"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding Status, UpdateSourceTrigger=PropertyChanged}"
                                                                  Background="Transparent" BorderThickness="0"/>
                                                    </Border>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Admin note" Width="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding AttendanceRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#DDE3E5" BorderThickness="0,0,0,1" MinHeight="48" Padding="4">
                                                    <TextBox Text="{Binding AdminNote, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" VerticalAlignment="Center"
                                                             Height="34" Padding="6,4" Margin="0"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Action" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding AttendanceRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#DDE3E5" BorderThickness="0,0,0,1" MinHeight="48" Padding="4">
                                                    <Button Content="Save" Tag="{Binding}" Click="SaveAttendanceButton_Click"
                                                            Padding="8,5" VerticalAlignment="Center"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Daily task" Width="145">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="8,4" CornerRadius="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FAD7D7"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DailyTaskDisplayStatus}" Value="Submitted">
                                                        <Setter Property="Background" Value="#D9F5E5"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DailyTaskDisplayStatus}" Value="Leave">
                                                        <Setter Property="Background" Value="#EDE9FE"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DailyTaskDisplayStatus}" Value="Half day">
                                                        <Setter Property="Background" Value="#FEF3C7"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding DailyTaskDisplayStatus}" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#A12622"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DailyTaskDisplayStatus}" Value="Submitted">
                                                            <Setter Property="Foreground" Value="#137A45"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DailyTaskDisplayStatus}" Value="Leave">
                                                            <Setter Property="Foreground" Value="#6D28D9"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DailyTaskDisplayStatus}" Value="Half day">
                                                            <Setter Property="Foreground" Value="#92400E"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Grid x:Name="LoadingOverlay" Background="#800F1A24" Visibility="Collapsed" Panel.ZIndex="10">
            <Border Width="260" Height="120" Background="White" CornerRadius="16" BorderBrush="#D7E5EA" BorderThickness="1.2">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar Width="42" Height="42" IsIndeterminate="True" Foreground="#0F4C5C" Margin="0,0,0,12"/>
                    <TextBlock Text="Loading attendance..." FontSize="16" FontWeight="SemiBold" Foreground="#12343D" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
