<Window x:Class="DMS.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DMS | Sign in"
        Icon="/Assets/dms-logo.png"
        Height="590" Width="820"
        MinHeight="590" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.95*"/>
            <ColumnDefinition Width="1.05*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource TealBrush}" Padding="42">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="/Assets/dms-logo.png" Width="270" Height="270"
                       Stretch="Uniform" HorizontalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" ToolTip="DMS logo"/>
                <TextBlock Text="Developer Management System"
                           FontFamily="pack://application:,,,/DMS;component/Assets/#Lato"
                           Foreground="White"
                           FontSize="16" FontWeight="SemiBold" TextAlignment="Center"
                           Margin="0,14,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="58,44,58,42">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRegistering}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="26"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Welcome back" Style="{StaticResource HeadingStyle}"/>
            <TextBlock Grid.Row="2" Text="Sign in to your workspace" Style="{StaticResource MutedStyle}"/>

            <TextBlock Grid.Row="4" Text="Username" Style="{StaticResource LabelStyle}"/>
            <TextBox Grid.Row="5" x:Name="UsernameBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Enter your workspace username"/>

            <TextBlock Grid.Row="7" Text="Password" Style="{StaticResource LabelStyle}"/>
            <PasswordBox Grid.Row="8" x:Name="PasswordBox" ToolTip="Enter your password"/>

            <TextBlock Grid.Row="10" Text="{Binding ErrorMessage}" Style="{StaticResource ErrorStyle}"/>
            <Button Grid.Row="12" Content="Sign in" Command="{Binding LoginCommand}" Height="46" IsDefault="True"/>

            <TextBlock Grid.Row="14" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}">
                New to DMS? <Hyperlink Command="{Binding CreateAccountCommand}" Style="{StaticResource LinkStyle}">Create an account</Hyperlink>
            </TextBlock>
        </Grid>

        <Grid Grid.Column="1" Margin="58,24,58,16">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRegistering}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Create your account" Style="{StaticResource HeadingStyle}"/>
            <TextBlock Grid.Row="2" Text="Use your work email to get started." Style="{StaticResource MutedStyle}"/>

            <TextBlock Grid.Row="4" Text="Email address" Style="{StaticResource LabelStyle}"/>
            <TextBox Grid.Row="5" Text="{Binding Register.Email, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Enter your email address" Height="34" Padding="10,6" Margin="0,3,0,0"/>

            <TextBlock Grid.Row="7" Text="Contact number" Style="{StaticResource LabelStyle}"/>
            <TextBox Grid.Row="8" Text="{Binding Register.ContactNumber, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Enter your contact number" Height="34" Padding="10,6" Margin="0,3,0,0"/>

            <TextBlock Grid.Row="10" Text="Password" Style="{StaticResource LabelStyle}"/>
            <PasswordBox Grid.Row="11" x:Name="RegisterPasswordBox" ToolTip="Use at least 6 characters"
                         Height="34" Padding="10,6" Margin="0,3,0,0"/>

            <TextBlock Grid.Row="13" Text="Confirm password" Style="{StaticResource LabelStyle}"/>
            <PasswordBox Grid.Row="14" x:Name="RegisterConfirmPasswordBox" ToolTip="Re-enter your password"
                         Height="34" Padding="10,6" Margin="0,3,0,0"/>

            <TextBlock Grid.Row="16" Text="{Binding Register.ErrorMessage}" Style="{StaticResource ErrorStyle}"/>
            <Button Grid.Row="18" Content="Create account" Command="{Binding Register.CreateAccountCommand}" Height="46" IsDefault="True"/>
            <TextBlock Grid.Row="20" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}">
                Already have an account? <Hyperlink Command="{Binding BackToLoginCommand}" Style="{StaticResource LinkStyle}">Sign in</Hyperlink>
            </TextBlock>
        </Grid>
    </Grid>
</Window>
