<Page x:Class="DMS.Views.AllDevelopersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      Title="All Developers">
    <Grid Background="#F5F7F8">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="All Developers" FontSize="32" FontWeight="Bold" Foreground="#17212B"/>
                    <TextBlock Text="Registered developer accounts in the system." Margin="0,8,0,0" Foreground="#66727D"/>
                </StackPanel>

                <Border Grid.Column="1" Width="240" Height="38" Margin="0,10,0,0" HorizontalAlignment="Right"
                        Background="#F8FBFB" BorderBrush="#B7D6DD" BorderThickness="1.5" CornerRadius="9">
                    <Grid Margin="8,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="⌕" FontSize="17" Foreground="#0F4C5C" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="SearchTextBox" Grid.Column="1" BorderThickness="0" Background="Transparent"
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Left"
                                 TextChanged="SearchTextBox_TextChanged" ToolTip="Search by username or email"
                                 FontSize="15" Padding="0,0,0,0" Margin="0,0,0,0"/>
                        <Button x:Name="ClearSearchButton" Grid.Column="2" Content="✕" Width="26" Height="24"
                                Background="Transparent" Foreground="#0F4C5C" FontSize="13" FontWeight="Bold"
                                Padding="0" Margin="4,0,0,0" BorderThickness="0" Click="ClearSearchButton_Click"/>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="12">
                <ListView x:Name="DeveloperListView" ItemsSource="{Binding}" BorderThickness="0" Background="Transparent">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                    <Setter Property="Background" Value="#FAD7D7"/>
                                    <Setter Property="Foreground" Value="#7A1F1F"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView x:Name="DeveloperGridView">
                            <GridViewColumn Header="Username" Width="180">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Username, FallbackValue='Not set'}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Email" DisplayMemberBinding="{Binding Email}" Width="260"/>
                            <GridViewColumn Header="Contact" DisplayMemberBinding="{Binding ContactNumber}" Width="160"/>
                            <GridViewColumn x:Name="DeactivatedByColumn" Header="Deactivated by" Width="170">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DeactivatedByAdminName}" Foreground="#7A1F1F"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Status" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Width="120"
                                                  Height="30"
                                                  HorizontalAlignment="Left"
                                                  Tag="{Binding Id}"
                                                  SelectedValue="{Binding Status, Mode=OneWay}"
                                                  SelectionChanged="StatusComboBox_SelectionChanged"
                                                  FontWeight="SemiBold"
                                                  BorderThickness="1"
                                                  BorderBrush="#B7D6DD">
                                            <ComboBox.Style>
                                                <Style TargetType="ComboBox">
                                                    <Setter Property="Background" Value="#1FAE67"/>
                                                    <Setter Property="Foreground" Value="#0F172A"/>
                                                    <Setter Property="TextElement.Foreground" Value="#0F172A"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Background" Value="#D85A5A"/>
                                                            <Setter Property="Foreground" Value="#0F172A"/>
                                                            <Setter Property="TextElement.Foreground" Value="#0F172A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ComboBox.Style>
                                            <sys:String>Active</sys:String>
                                            <sys:String>Inactive</sys:String>
                                        </ComboBox>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
        </Grid>
    </Grid>
</Page>
