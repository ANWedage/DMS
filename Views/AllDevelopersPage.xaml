<Page x:Class="DMS.Views.AllDevelopersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Title="Developer Management">
    <Grid Background="#E8EDEF">
        <Grid x:Name="MainContentGrid" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Developer Management" FontSize="32" FontWeight="Bold" Foreground="#17212B"/>
                    <TextBlock Text="Registered developer accounts in the system." Margin="0,8,0,0" Foreground="#66727D"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border Width="220" Height="78" Margin="0,0,10,0" Background="#F8FBFB" BorderBrush="#B7D6DD" BorderThickness="1.5" CornerRadius="12" Padding="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#E7F3F2" Padding="14,10,10,10" CornerRadius="12,0,0,12">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="TOTAL" Foreground="#0F4C5C" FontSize="10" FontWeight="SemiBold" Opacity="0.9"/>
                                    <TextBlock x:Name="DeveloperCountText" Text="0" Foreground="#12343D" FontSize="28" FontWeight="Bold" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#D9E7EA" Width="1" Margin="0,10"/>

                            <Border Grid.Column="2" Background="#FDEAEA" Padding="10,10,14,10" CornerRadius="0,12,12,0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="INACTIVE" Foreground="#8C2F2F" FontSize="10" FontWeight="SemiBold" Opacity="0.9"/>
                                    <TextBlock x:Name="InactiveDeveloperCountText" Text="0" Foreground="#B63A3A" FontSize="28" FontWeight="Bold" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel Margin="0,8,10,0">
                        <TextBlock Text="Submission date" FontSize="11" Foreground="#66727D"/>
                        <DatePicker x:Name="DailyTaskDatePicker"
                                    Width="132"
                                    Height="30"
                                    SelectedDateChanged="DailyTaskDatePicker_SelectedDateChanged"
                                    ToolTip="View daily task submission status for this date"/>
                    </StackPanel>
                    <Border Width="240" Height="38" Margin="0,10,0,0"
                            Background="#F8FBFB" BorderBrush="#B7D6DD" BorderThickness="1.5" CornerRadius="9">
                        <Grid Margin="8,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="⌕" FontSize="17" Foreground="#0F4C5C" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="SearchTextBox" Grid.Column="1" BorderThickness="0" Background="Transparent"
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Left"
                                 TextChanged="SearchTextBox_TextChanged" ToolTip="Search by username or email"
                                 FontSize="15" Padding="0,0,0,0" Margin="0,0,0,0"/>
                        <Button x:Name="ClearSearchButton" Grid.Column="2" Content="✕" Width="26" Height="24"
                                Background="Transparent" Foreground="#0F4C5C" FontSize="13" FontWeight="Bold"
                                Padding="0" Margin="4,0,0,0" BorderThickness="0" Click="ClearSearchButton_Click"/>
                        </Grid>
                    </Border>
                    <Button x:Name="RefreshButton" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" Width="38" Height="38" Margin="10,10,0,0"
                            Click="RefreshButton_Click" ToolTip="Refresh developer list"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="12">
                <ListView x:Name="DeveloperListView" ItemsSource="{Binding}" BorderThickness="0" Background="Transparent">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                    <Setter Property="Background" Value="#FAD7D7"/>
                                    <Setter Property="Foreground" Value="#7A1F1F"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView x:Name="DeveloperGridView">
                            <GridViewColumn Header="Username" Width="180">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Username, FallbackValue='Not set'}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Email" DisplayMemberBinding="{Binding Email}" Width="260"/>
                            <GridViewColumn Header="Contact" DisplayMemberBinding="{Binding ContactNumber}" Width="160"/>
                            <GridViewColumn Header="Daily task" Width="145">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,4" CornerRadius="10" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FAD7D7"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DailyTaskDisplayStatus}" Value="Submitted">
                                                            <Setter Property="Background" Value="#D9F5E5"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DailyTaskDisplayStatus}" Value="Leave">
                                                            <Setter Property="Background" Value="#EDE9FE"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DailyTaskDisplayStatus}" Value="Half day">
                                                            <Setter Property="Background" Value="#FEF3C7"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding DailyTaskSubmissionStatus}" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#A12622"/>
                                                        <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DailyTaskDisplayStatus}" Value="Submitted">
                                                                <Setter Property="Foreground" Value="#137A45"/>
                                                            </DataTrigger>
                                                                <DataTrigger Binding="{Binding DailyTaskDisplayStatus}" Value="Leave">
                                                                    <Setter Property="Foreground" Value="#6D28D9"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding DailyTaskDisplayStatus}" Value="Half day">
                                                                    <Setter Property="Foreground" Value="#92400E"/>
                                                                </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="DeactivatedByColumn" Header="Deactivated by" Width="170">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DeactivatedByAdminName}" Foreground="#7A1F1F"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Position" Width="220">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0">
                                            <Border Width="64"
                                                    Height="22"
                                                    CornerRadius="11"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E5E7EB"/>
                                                        <Setter Property="BorderBrush" Value="#D1D5DB"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Position}" Value="QA">
                                                                <Setter Property="Background" Value="#3BAA59"/>
                                                                <Setter Property="BorderBrush" Value="#2E8B4D"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Position}" Value="UI/UX">
                                                                <Setter Property="Background" Value="#8B5CF6"/>
                                                                <Setter Property="BorderBrush" Value="#7C3AED"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Position}" Value="Full Stack">
                                                                <Setter Property="Background" Value="#0EA5E9"/>
                                                                <Setter Property="BorderBrush" Value="#0284C7"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Position, FallbackValue='-'}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <ComboBox Width="110"
                                                      Height="30"
                                                      HorizontalAlignment="Left"
                                                      Tag="{Binding Id}"
                                                      SelectedItem="{Binding Position, Mode=OneWay}"
                                                      SelectionChanged="PositionComboBox_SelectionChanged"
                                                      FontWeight="SemiBold"
                                                      BorderThickness="1"
                                                      BorderBrush="#B7D6DD">
                                                <ComboBox.Resources>
                                                    <Style TargetType="ComboBoxItem">
                                                        <Setter Property="Padding" Value="8,4"/>
                                                        <Setter Property="Foreground" Value="#1F2937"/>
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="Content" Value="QA">
                                                                <Setter Property="Background" Value="#EAF7EC"/>
                                                                <Setter Property="Foreground" Value="#166534"/>
                                                            </Trigger>
                                                            <Trigger Property="Content" Value="UI/UX">
                                                                <Setter Property="Background" Value="#F3E8FF"/>
                                                                <Setter Property="Foreground" Value="#6D28D9"/>
                                                            </Trigger>
                                                            <Trigger Property="Content" Value="Full Stack">
                                                                <Setter Property="Background" Value="#E0F2FE"/>
                                                                <Setter Property="Foreground" Value="#075985"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ComboBox.Resources>
                                                <ComboBox.Items>
                                                    <sys:String>QA</sys:String>
                                                    <sys:String>UI/UX</sys:String>
                                                    <sys:String>Full Stack</sys:String>
                                                </ComboBox.Items>
                                                <ComboBox.Style>
                                                    <Style TargetType="ComboBox">
                                                        <Setter Property="Background" Value="#E5E7EB"/>
                                                        <Setter Property="Foreground" Value="#1F2937"/>
                                                        <Setter Property="TextElement.Foreground" Value="#1F2937"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Position}" Value="QA">
                                                                <Setter Property="Background" Value="#EAF7EC"/>
                                                                <Setter Property="Foreground" Value="#166534"/>
                                                                <Setter Property="TextElement.Foreground" Value="#166534"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Position}" Value="UI/UX">
                                                                <Setter Property="Background" Value="#F3E8FF"/>
                                                                <Setter Property="Foreground" Value="#6D28D9"/>
                                                                <Setter Property="TextElement.Foreground" Value="#6D28D9"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Position}" Value="Full Stack">
                                                                <Setter Property="Background" Value="#E0F2FE"/>
                                                                <Setter Property="Foreground" Value="#075985"/>
                                                                <Setter Property="TextElement.Foreground" Value="#075985"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ComboBox.Style>
                                            </ComboBox>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Leaving date" Width="145">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <DatePicker Width="125"
                                                    Height="30"
                                                    Tag="{Binding Id}"
                                                    SelectedDate="{Binding LeavingDate, Mode=OneWay}"
                                                    SelectedDateChanged="LeavingDatePicker_SelectedDateChanged"
                                                    ToolTip="Set or clear the internship finish date"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Status" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Width="120"
                                                  Height="30"
                                                  HorizontalAlignment="Left"
                                                  Tag="{Binding Id}"
                                                  SelectedValue="{Binding Status, Mode=OneWay}"
                                                  SelectionChanged="StatusComboBox_SelectionChanged"
                                                  FontWeight="SemiBold"
                                                  BorderThickness="1"
                                                  BorderBrush="#B7D6DD">
                                            <ComboBox.Style>
                                                <Style TargetType="ComboBox">
                                                    <Setter Property="Background" Value="#1FAE67"/>
                                                    <Setter Property="Foreground" Value="#0F172A"/>
                                                    <Setter Property="TextElement.Foreground" Value="#0F172A"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Background" Value="#D85A5A"/>
                                                            <Setter Property="Foreground" Value="#0F172A"/>
                                                            <Setter Property="TextElement.Foreground" Value="#0F172A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ComboBox.Style>
                                            <sys:String>Active</sys:String>
                                            <sys:String>Inactive</sys:String>
                                        </ComboBox>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Actions" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Delete"
                                                Tag="{Binding Id}"
                                                Click="DeleteButton_Click"
                                                Padding="10,4"
                                                Foreground="#FFFFFF"
                                                Background="#B3261E"
                                                BorderThickness="0"
                                                ToolTip="Delete this developer account"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
        </Grid>

        <Grid x:Name="LoadingOverlay" Background="#800F1A24" Visibility="Collapsed" Panel.ZIndex="10">
            <Border Width="260" Height="120" Background="White" CornerRadius="16" BorderBrush="#D7E5EA" BorderThickness="1.2">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar Width="42" Height="42" IsIndeterminate="True" Foreground="#0F4C5C" Margin="0,0,0,12"/>
                    <TextBlock Text="Loading developers..." FontSize="16" FontWeight="SemiBold" Foreground="#12343D" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
