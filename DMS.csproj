<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DMS</RootNamespace>
    <AssemblyName>DMS</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <ApplicationIcon>Assets\dms-logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="DMS.Api\**" />
    <Compile Remove="DMS.Core\**" />
    <Compile Remove="Tools\CreateAdmin\**" />
    <PackageReference Include="MongoDB.Driver" Version="2.28.0" />
    <PackageReference Include="QuestPDF" Version="2025.7.4" />
    <Resource Include="Assets\dms-logo.png" />
    <None Include="Assets\dms-logo.ico" />
    <Resource Include="Assets\Lato-BoldItalic.ttf" />
  </ItemGroup>

</Project>
