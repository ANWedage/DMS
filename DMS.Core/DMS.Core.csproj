<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DMS</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MongoDB.Driver" Version="2.28.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Data\*.cs" Link="Data\%(Filename)%(Extension)" />
    <Compile Include="..\Helpers\AppSession.cs" Link="Helpers\AppSession.cs" />
    <Compile Include="..\Helpers\PasswordHasher.cs" Link="Helpers\PasswordHasher.cs" />
    <Compile Include="..\Helpers\SecurityValidator.cs" Link="Helpers\SecurityValidator.cs" />
    <Compile Include="..\Models\*.cs" Link="Models\%(Filename)%(Extension)" />
    <Compile Include="..\Services\*.cs" Link="Services\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>